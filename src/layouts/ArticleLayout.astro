---
import { getImage } from 'astro:assets';
import PageLayout from './PageLayout.astro';
import PhotoHero from '../components/PhotoHero.astro';
import SchemaArticle from '../components/SchemaArticle.astro';
import { useTranslations } from '../i18n/utils';
import { defaultLocale, type Locale } from '../i18n/ui';
import { pageHref } from '../data/pageTranslations';
import { business } from '../data/business';
import { absoluteUrl } from '../lib/seo';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  path: string;
  cover: ImageMetadata;
  coverAlt: string;
  eyebrow: string;
  date: Date;
  dateDisplay: string;
  pullIntro: string;
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  path,
  cover,
  coverAlt,
  eyebrow,
  date,
  dateDisplay,
  pullIntro,
  locale = defaultLocale,
  alternates,
} = Astro.props;
const ogImage = await getImage({ src: cover, width: 1200, format: 'webp' });
const publishedTime = date.toISOString();
const t = useTranslations(locale);
const journalIndexHref = locale === defaultLocale ? '/journal/' : `/${locale}/journal/`;
const legalHref = pageHref('legal-notice', locale);
const canonicalUrl = absoluteUrl(Astro.site!, path);
const copyAttributionByLocale: Record<Locale, string> = {
  en: `— Excerpt from ${business.name} (${canonicalUrl}). Unauthorized reproduction prohibited.`,
  es: `— Extracto de ${business.name} (${canonicalUrl}). Reproducción no autorizada.`,
  fr: `— Extrait de ${business.name} (${canonicalUrl}). Reproduction non autorisée.`,
  ja: `— ${business.name}（${canonicalUrl}）からの抜粋。無断複製を禁じます。`,
};
const copyAttribution = copyAttributionByLocale[locale];
---

<PageLayout
  title={`${title} — Wild on the Farm | Boquete Cloud Forest Lodge`}
  description={description}
  path={path}
  image={ogImage.src}
  type="article"
  publishedTime={publishedTime}
  pullIntro={pullIntro}
  locale={locale}
  alternates={alternates}
>
  <Fragment slot="hero">
    <PhotoHero image={cover} alt={coverAlt} eyebrow={eyebrow}>
      {title}
    </PhotoHero>
  </Fragment>

  <SchemaArticle title={title} description={description} imageUrl={ogImage.src} path={path} publishedTime={publishedTime} />

  <article class="prose">
    <div class="article-meta container container-article">
      <time>{dateDisplay}</time>
    </div>
    <div class="container container-article article-copy-protect">
      <slot />
    </div>
    <div class="container container-article article-copyright">
      <p>
        {t('journal.copyrightNotice')}
        {' '}
        <a href={legalHref}>{t('journal.legalNoticeLink')}</a>
      </p>
    </div>
  </article>

  <script define:vars={{ copyAttribution }}>
    const content = document.querySelector('.article-copy-protect');
    if (content) {
      content.addEventListener('copy', (event) => {
        const selection = document.getSelection();
        const text = selection ? selection.toString() : '';
        if (text.trim().length < 40 || !event.clipboardData) return;
        event.clipboardData.setData('text/plain', `${text}\n\n${copyAttribution}`);
        event.preventDefault();
      });
    }
  </script>

  <Fragment slot="footer">
    <div class="section-label">{t('journal.continueReading')}</div>
    <h2>{t('journal.moreFromJournal')}</h2>
    <div class="contact-list">
      <a href={journalIndexHref}>{t('journal.allPosts')}</a>
    </div>
  </Fragment>
</PageLayout>
