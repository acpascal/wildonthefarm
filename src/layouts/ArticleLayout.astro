---
import { getImage } from 'astro:assets';
import PageLayout from './PageLayout.astro';
import PhotoHero from '../components/PhotoHero.astro';
import { useTranslations } from '../i18n/utils';
import { defaultLocale, type Locale } from '../i18n/ui';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  path: string;
  cover: ImageMetadata;
  coverAlt: string;
  eyebrow: string;
  dateDisplay: string;
  pullIntro: string;
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  path,
  cover,
  coverAlt,
  eyebrow,
  dateDisplay,
  pullIntro,
  locale = defaultLocale,
  alternates,
} = Astro.props;
const ogImage = await getImage({ src: cover, width: 1200, format: 'webp' });
const t = useTranslations(locale);
const journalIndexHref = locale === defaultLocale ? '/journal/' : `/${locale}/journal/`;
---

<PageLayout
  title={`${title} — Wild on the Farm | Boquete Cloud Forest Lodge`}
  description={description}
  path={path}
  image={ogImage.src}
  pullIntro={pullIntro}
  locale={locale}
  alternates={alternates}
>
  <Fragment slot="hero">
    <PhotoHero image={cover} alt={coverAlt} eyebrow={eyebrow}>
      {title}
    </PhotoHero>
  </Fragment>

  <article class="prose">
    <div class="article-meta container container-article">
      <time>{dateDisplay}</time>
    </div>
    <div class="container container-article">
      <slot />
    </div>
  </article>

  <Fragment slot="footer">
    <div class="section-label">{t('journal.continueReading')}</div>
    <h2>{t('journal.moreFromJournal')}</h2>
    <div class="contact-list">
      <a href={journalIndexHref}>{t('journal.allPosts')}</a>
    </div>
  </Fragment>
</PageLayout>
