---
import { getImage } from 'astro:assets';
import PageLayout from './PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import ReserveContactBlock from '../components/ReserveContactBlock.astro';
import { useTranslations } from '../i18n/utils';
import { defaultLocale, type Locale } from '../i18n/ui';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  path: string;
  cover: ImageMetadata;
  coverAlt: string;
  eyebrow: string;
  dateDisplay: string;
  pullIntro: string;
  locale?: Locale;
}

const {
  title,
  description,
  path,
  cover,
  coverAlt,
  eyebrow,
  dateDisplay,
  pullIntro,
  locale = defaultLocale,
} = Astro.props;
const ogImage = await getImage({ src: cover, width: 1200, format: 'webp' });
const t = useTranslations(locale);
const journalIndexHref = locale === defaultLocale ? '/journal/' : `/${locale}/journal/`;
---

<PageLayout
  title={`${title} — Wild on the Farm | Boquete Cloud Forest Lodge`}
  description={description}
  path={path}
  image={ogImage.src}
  pullIntro={pullIntro}
  locale={locale}
>
  <Fragment slot="hero">
    <PageHero image={cover} alt={coverAlt} eyebrow={eyebrow}>
      {title}
    </PageHero>
  </Fragment>

  <div class="article-meta container">
    <time>{dateDisplay}</time>
  </div>

  <article class="journal-article">
    <div class="container">
      <slot />
    </div>
  </article>

  <ReserveCTA>
    <Fragment slot="left">
      <div class="section-label">{t('journal.continueReading')}</div>
      <h2>{t('journal.moreFromJournal')}</h2>
      <div class="contact-list">
        <a href={journalIndexHref}>{t('journal.allPosts')}</a>
      </div>
    </Fragment>
    <Fragment slot="right">
      <ReserveContactBlock locale={locale} />
    </Fragment>
  </ReserveCTA>
</PageLayout>
