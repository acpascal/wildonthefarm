---
import BaseLayout from './BaseLayout.astro';
import PullIntro from '../components/PullIntro.astro';
import type { PageSeo } from '../lib/seo';
import { defaultLocale, type Locale } from '../i18n/ui';

interface Props extends PageSeo {
  locale?: Locale;
  /** Italic centered lede shown right below the hero, if any. Line breaks
   *  in the string start a new paragraph. */
  pullIntro?: string;
  /** Overrides for the footer's ReserveContactBlock — use when the default
   *  "Reserve" copy would repeat something already said on the page. */
  reserveLabel?: string;
  reserveHeading?: string;
  reserveDescription?: string;
}

const {
  locale = defaultLocale,
  pullIntro,
  reserveLabel,
  reserveHeading,
  reserveDescription,
  ...seo
} = Astro.props;
---

<BaseLayout
  locale={locale}
  reserveLabel={reserveLabel}
  reserveHeading={reserveHeading}
  reserveDescription={reserveDescription}
  {...seo}
>
  <slot name="hero" />
  {
    pullIntro && (
      <PullIntro
        paragraphs={pullIntro
          .split('\n')
          .map((p) => p.trim())
          .filter(Boolean)}
      />
    )
  }
  <slot />
  <slot name="footer" slot="footer" />
</BaseLayout>
