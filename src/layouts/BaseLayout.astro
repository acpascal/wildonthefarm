---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { PageSeo } from '../lib/seo';
import { defaultLocale, type Locale } from '../i18n/ui';
import { pageAlternatesForPath } from '../data/pageTranslations';

interface Props extends PageSeo {
  locale?: Locale;
  reserveLabel?: string;
  reserveHeading?: string;
  reserveDescription?: string;
}

const {
  locale = defaultLocale,
  reserveLabel,
  reserveHeading,
  reserveDescription,
  ...seo
} = Astro.props;
// Explicit `alternates` (e.g. a journal article's per-entry translations)
// wins; otherwise derive it from `path` so a page can never forget to wire
// up its own language switcher.
const alternates = seo.alternates ?? pageAlternatesForPath(seo.path);
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead {...seo} alternates={alternates} />
  </head>
  <body>
    <Nav locale={locale} alternates={alternates} />
    <slot />
    {
      Astro.slots.has('footer') ? (
        <Footer locale={locale} reserveLabel={reserveLabel} reserveHeading={reserveHeading} reserveDescription={reserveDescription}>
          <slot name="footer" />
        </Footer>
      ) : (
        <Footer locale={locale} reserveLabel={reserveLabel} reserveHeading={reserveHeading} reserveDescription={reserveDescription} />
      )
    }
    <script>
      import '../scripts/lightbox.js';
    </script>
  </body>
</html>
