---
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n/utils';
import { defaultLocale, type Locale } from '../i18n/ui';
import { navItems, isDropdown, type NavLink } from '../data/nav';
import { pageHref } from '../data/pageTranslations';
import { business } from '../data/business';
import LanguageSwitcher from './LanguageSwitcher.astro';
import logoMark from '../assets/brand/logo-notext.png';

interface Props {
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale = defaultLocale, alternates } = Astro.props;
const t = useTranslations(locale);
const home = pageHref('home', locale);
const contactHref = pageHref('faqs-contact', locale);
const resolveHref = (item: NavLink) => (item.pageId ? pageHref(item.pageId, locale) : item.href ?? '#');
const currentPath = Astro.url.pathname;
const isCurrent = (item: NavLink) => resolveHref(item) === currentPath;
const nameWords = business.name.split(' ');
const taglineWords = business.tagline.split(' ');
---

<nav class="nav" data-nav>
  <div class="nav-inner container">
    <a href={home} class="logo">
      <Image src={logoMark} alt="" width={32} height={50} loading="eager" />
      <span class="logo-text">
        <span class="logo-line logo-name">
          {nameWords.map((word) => <span>{word}</span>)}
        </span>
        <span class="logo-line logo-tagline">
          {taglineWords.map((word) => <span>{word}</span>)}
        </span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-links"
      data-nav-toggle
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="sr-only">Menu</span>
    </button>

    <div class="nav-links" id="nav-links" data-nav-links>
      {
        navItems.map((item) =>
          isDropdown(item) ? (
            <div class="nav-dropdown">
              <button
                class={item.items.some(isCurrent) || isCurrent(item) ? 'nav-dropdown-toggle is-current' : 'nav-dropdown-toggle'}
                type="button"
                aria-haspopup="true"
                aria-expanded="false"
                data-dropdown-toggle
              >
                {t(item.key)}
                <svg viewBox="0 0 12 8" aria-hidden="true">
                  <path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </button>
              <div class="nav-dropdown-menu">
                {item.items.map((sub) => (
                  <a
                    href={resolveHref(sub)}
                    class={isCurrent(sub) ? 'is-current' : undefined}
                    aria-current={isCurrent(sub) ? 'page' : undefined}
                  >
                    {t(sub.key)}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={resolveHref(item)}
              class={isCurrent(item) ? 'is-current' : undefined}
              aria-current={isCurrent(item) ? 'page' : undefined}
            >
              {t(item.key)}
            </a>
          )
        )
      }
      <LanguageSwitcher locale={locale} alternates={alternates} />
    </div>

    <a href={contactHref} class="btn btn-normal nav-reserve">{t('nav.reserve')}</a>
  </div>
</nav>

<script>
  // Mobile drawer + dropdown disclosure. Desktop dropdowns already reveal
  // via CSS :hover/:focus-within with no JS — this only adds click-to-toggle
  // for touch/keyboard users and the mobile drawer's open/close state.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const links = nav.querySelector<HTMLElement>('[data-nav-links]');

    toggle?.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    const dropdownToggles = nav.querySelectorAll<HTMLButtonElement>('[data-dropdown-toggle]');

    const closeDropdowns = (except?: Element) => {
      dropdownToggles.forEach((btn) => {
        const dropdown = btn.closest('.nav-dropdown');
        if (dropdown && dropdown !== except) {
          dropdown.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    };

    // Desktop already reveals dropdowns via CSS :hover/:focus-within — clicking
    // there should do nothing, same as the rest of the page. Click-to-toggle
    // only applies inside the mobile drawer, where hover doesn't exist.
    const isDesktop = () => window.matchMedia('(min-width: 860px)').matches;

    dropdownToggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (isDesktop()) {
          // Clicking focuses the button, which alone reveals the menu via
          // CSS :focus-within — and since this button never navigates,
          // nothing else would ever remove that focus. Blur it so a click
          // has no lasting effect, matching plain hover-only behavior.
          btn.blur();
          return;
        }
        const dropdown = btn.closest('.nav-dropdown');
        const isOpen = dropdown?.classList.contains('is-open') ?? false;
        closeDropdowns(isOpen ? undefined : dropdown ?? undefined);
        if (dropdown) {
          dropdown.classList.toggle('is-open', !isOpen);
          btn.setAttribute('aria-expanded', String(!isOpen));
        }
      });
    });

    document.addEventListener('click', (e) => {
      if (!isDesktop() && !nav.contains(e.target as Node)) closeDropdowns();
    });

    document.addEventListener('keydown', (e) => {
      if (!isDesktop() && e.key === 'Escape') closeDropdowns();
    });

    links?.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle?.setAttribute('aria-expanded', 'false');
        closeDropdowns();
      });
    });
  }
</script>
