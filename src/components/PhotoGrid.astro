---
import PhotoTile from './PhotoTile.astro';
import type { PhotoItem } from '../lib/photos';

interface Props {
  items: PhotoItem[];
  groupId?: string;
  /** 'varied' applies the same explicit-size asymmetric layout as Gallery,
   * for larger photo sets where uniform tiles would feel flat. */
  variant?: 'uniform' | 'varied';
}

const { items, groupId, variant = 'uniform' } = Astro.props;
---

<div class:list={['photo-grid', { varied: variant === 'varied' }]}>
  {items.map((item) => <PhotoTile image={item.image} alt={item.alt} size={variant === 'varied' ? item.size : undefined} groupId={groupId} />)}
</div>
