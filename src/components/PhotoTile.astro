---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Explicit tile size — never inferred from list position, so reordering
   * or adding/removing photos can't silently corrupt the grid layout. */
  size?: 'lg' | 'wide' | 'tall' | 'normal';
  /** Tiles sharing a groupId open together as one lightbox slideshow. */
  groupId?: string;
}

const { image, alt, size = 'normal', groupId } = Astro.props;

const sizeClass = size === 'normal' ? '' : `pt-${size}`;
const spansTwoCols = size === 'lg' || size === 'wide';
const sizes = spansTwoCols ? '(min-width: 860px) 50vw, 100vw' : '(min-width: 860px) 25vw, 50vw';

// The lightbox target is a large-but-optimized version, not the raw
// original — full quality for a deliberate "view full size" click,
// without shipping an unnecessarily huge unprocessed file.
const full = await getImage({ src: image, width: 1800, format: 'webp' });
---

<a
  href={full.src}
  class:list={['photo-tile', sizeClass]}
  data-lightbox
  data-gallery={groupId}
  aria-label={alt}
>
  <Image src={image} alt={alt} widths={[400, 800, 1200]} sizes={sizes} loading="lazy" />
</a>
