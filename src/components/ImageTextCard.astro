---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  eyebrow?: string;
  groupId?: string;
}

const { image, alt, title, eyebrow, groupId } = Astro.props;
const full = await getImage({ src: image, width: 1800, format: 'webp' });
---

<div class="image-text-card">
  <a href={full.src} class="image-text-card-photo" data-lightbox data-gallery={groupId} aria-label={alt}>
    <Image src={image} alt={alt} widths={[300, 500, 700]} sizes="(min-width: 860px) 280px, (min-width: 640px) 45vw, 100vw" loading="lazy" />
  </a>
  <h3>{title}</h3>
  {eyebrow && <span class="card-eyebrow">{eyebrow}</span>}
  <p><slot /></p>
</div>
