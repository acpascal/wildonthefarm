---
interface Pillar {
  title: string;
  description: string;
}

interface Props {
  pillars: Pillar[];
}

const { pillars } = Astro.props;
---

<div class="pillars">
  {
    pillars.map((p) => (
      <div class="pillar">
        <h3>{p.title}</h3>
        <p>{p.description}</p>
      </div>
    ))
  }
</div>
