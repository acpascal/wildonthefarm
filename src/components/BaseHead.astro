---
import { Font } from 'astro:assets';
import { buildSeo, type PageSeo } from '../lib/seo';
import { business } from '../data/business';
import { defaultLocale } from '../i18n/ui';

interface Props extends PageSeo {}

const props = Astro.props;
const seo = buildSeo(Astro.site!, props);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
{seo.noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
{seo.image && <meta property="og:image" content={seo.image} />}
<meta property="og:url" content={seo.canonical} />
<meta property="og:site_name" content={business.name} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
{seo.image && <meta name="twitter:image" content={seo.image} />}

<link rel="canonical" href={seo.canonical} />
{
  seo.alternates &&
    Object.entries(seo.alternates).map(([locale, href]) => (
      <link rel="alternate" hreflang={locale} href={href} />
    ))
}
{seo.alternates?.[defaultLocale] && <link rel="alternate" hreflang="x-default" href={seo.alternates[defaultLocale]} />}
<link rel="icon" href="/favicon.ico" />

<Font cssVariable="--font-display" preload />
<Font cssVariable="--font-body" preload />
