---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  name: string;
  latin: string;
  groupId?: string;
}

const { image, alt, name, latin, groupId } = Astro.props;
const full = await getImage({ src: image, width: 1800, format: 'webp' });
---

<div class="species-card">
  <a href={full.src} class="species-photo" data-lightbox data-gallery={groupId} aria-label={alt}>
    <Image src={image} alt={alt} widths={[300, 500, 700]} sizes="(min-width: 860px) 280px, 45vw" loading="lazy" />
  </a>
  <div class="species-body">
    <h3>{name}</h3>
    <span class="species-latin">{latin}</span>
    <p><slot /></p>
  </div>
</div>
