---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  tagline: string;
  eyebrow: string;
  /** CSS background-position, for images with an off-center focal point. */
  focalPosition?: string;
}

const { image, alt, title, tagline, eyebrow, focalPosition = 'center' } = Astro.props;

// Full-bleed background hero — same justified exception as PageHero: the
// image URL is per-page data, not expressible as a static CSS class.
const optimized = await getImage({ src: image, width: 1920, format: 'webp' });
---

<header
  class="hero"
  style={`background-image:url(${optimized.src}); background-position:${focalPosition};`}
  role="img"
  aria-label={alt}
>
  <div class="hero-content">
    <h1>{title}</h1>
    <p class="hero-tagline">{tagline}</p>
    <div class="hero-eyebrow">{eyebrow}</div>
    <slot />
  </div>
</header>
