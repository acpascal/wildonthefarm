---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface CardItem {
  href: string;
  image: ImageMetadata;
  alt: string;
  label: string;
  title: string;
  description: string;
}

interface Props {
  items: CardItem[];
}

const { items } = Astro.props;

const resolved = await Promise.all(
  items.map(async (item) => ({
    ...item,
    bg: (await getImage({ src: item.image, width: 900, format: 'webp' })).src,
  }))
);
---

<div class="cards">
  {
    resolved.map((item) => (
      <a href={item.href} class="card" style={`background-image:url(${item.bg})`} role="img" aria-label={item.alt}>
        <div class="card-label">
          <div class="section-label">{item.label}</div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      </a>
    ))
  }
</div>
