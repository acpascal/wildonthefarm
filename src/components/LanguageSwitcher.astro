---
import { languages, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Every locale this specific page has a real translation for. Only one entry means nothing to switch to. */
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const entries = alternates ? (Object.entries(alternates) as [Locale, string][]) : [];
---

{
  entries.length > 1 && (
    <div class="nav-dropdown lang-switch">
      <button
        class="lang-switch-toggle"
        type="button"
        aria-expanded="false"
        aria-haspopup="true"
        data-dropdown-toggle
      >
        <svg class="lang-switch-globe" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" stroke-width="1.3" />
          <path
            d="M1.75 10h16.5M10 1.75c2.15 2.35 3.4 5.5 3.4 8.25s-1.25 5.9-3.4 8.25c-2.15-2.35-3.4-5.5-3.4-8.25S7.85 4.1 10 1.75z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
          />
        </svg>
        <span class="lang-switch-current">{locale.toUpperCase()}</span>
        <svg class="lang-switch-chevron" viewBox="0 0 12 8" aria-hidden="true">
          <path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
        <span class="sr-only">Language</span>
      </button>
      <div class="nav-dropdown-menu lang-switch-menu">
        {entries.map(([loc, href]) => (
          <a href={href} class:list={[{ 'is-current': loc === locale }]} aria-current={loc === locale ? 'page' : undefined}>
            {languages[loc]}
          </a>
        ))}
      </div>
    </div>
  )
}
