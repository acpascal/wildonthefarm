---
import PhotoTile from './PhotoTile.astro';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  size?: 'lg' | 'wide' | 'tall' | 'normal';
}

interface Props {
  items: GalleryItem[];
  groupId?: string;
}

const { items, groupId = 'gallery' } = Astro.props;
---

<div class="gallery">
  {items.map((item) => <PhotoTile image={item.image} alt={item.alt} size={item.size} groupId={groupId} />)}
</div>
