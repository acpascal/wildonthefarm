---
interface Props {
  label?: string;
  heading?: string;
  noPadTop?: boolean;
  noPadBottom?: boolean;
}

const { label, heading, noPadTop = false, noPadBottom = false } = Astro.props;
---

<section class:list={{ 'no-pad-top': noPadTop, 'no-pad-bottom': noPadBottom }}>
  <div class="container">
    {label && <div class="section-label">{label}</div>}
    {heading && <h2 class="lede">{heading}</h2>}
    <slot />
  </div>
</section>
