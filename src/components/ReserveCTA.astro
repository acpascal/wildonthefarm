---
// Two-column CTA band. Both columns are genuinely page-specific in the
// source content (which side holds the contact block varies), so both
// are plain named slots rather than fixed props — ReserveContactBlock.astro
// is the reusable piece for whichever column needs the standard contact info.
---

<section class="reserve" id="reserve">
  <div class="container reserve-grid">
    <div class="reserve-info">
      <slot name="left" />
    </div>
    <div>
      <slot name="right" />
    </div>
  </div>
</section>
