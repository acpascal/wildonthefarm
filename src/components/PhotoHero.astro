---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ScrollCue from './ScrollCue.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow: string;
  /** CSS object-position, for images with an off-center focal point. */
  focalPosition?: string;
}

const { image, alt, eyebrow, focalPosition = 'center' } = Astro.props;
---

<header class="photo-hero">
  <Image
    src={image}
    alt={alt}
    widths={[480, 900, 1600, 2000]}
    sizes="100vw"
    priority
    style={`object-position:${focalPosition}`}
  />
  <div class="photo-hero-caption container">
    <div class="hero-eyebrow">{eyebrow}</div>
    <h1><slot /></h1>
  </div>
  <ScrollCue />
</header>
