---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow: string;
}

const { image, alt, eyebrow } = Astro.props;
---

<header class="photo-hero">
  <Image src={image} alt={alt} widths={[480, 900, 1600]} sizes="100vw" priority />
  <div class="photo-hero-caption">
    <div class="hero-eyebrow">{eyebrow}</div>
    <h1><slot /></h1>
  </div>
</header>
