---
import { useTranslations, mailtoHref } from '../i18n/utils';
import { defaultLocale, type Locale } from '../i18n/ui';
import { pageHref } from '../data/pageTranslations';
import { business } from '../data/business';

interface Props {
  locale?: Locale;
  heading?: string;
  label?: string;
  description?: string;
}

const { locale = defaultLocale, heading, label, description } = Astro.props;
const t = useTranslations(locale);
const contactHref = pageHref('contact', locale);
---

<div class="section-label">{label ?? t('nav.reserve')}</div>
<h2>{heading ?? t('reserve.defaultHeading')}</h2>
{description && <p>{description}</p>}
<div class="contact-list">
  <a href={business.whatsappHref}>{business.phone} (WhatsApp)</a>
  <a href={mailtoHref(business.email, locale)}>{business.email}</a>
  <a href={contactHref}>{t('reserve.contactForm')}</a>
</div>
