const t = labels[locale as keyof typeof labels] ?? labels.fr;
const languageIndex = { fr: 0, en: 1, es: 2, ja: 3 }[locale] ?? 0;
t.errorSend = t.errorSend.replace('{phone}', business.phone).replace('{email}', business.email);
const money = (n: number) => t.money.replace('{n}', String(n));

const hikes = options.flatMap(({ hike }) =>
  hike
    ? [
        {
          slug: hike.slug,
          title: hike.title,
          weekdays: hike.weekdays,
          meetingPoint: hike.meetingPoint[locale],
          meetingPointFr: hike.meetingPoint.fr,
          startTime: hike.startTime,
          maxPeople: hike.maxPeople,
          price: hike.pricePerPerson,
          meal: hike.meal ?? null,
          depositRate: hike.depositRate,
          minNoticeDays: hike.minNoticeDays,
          lastDate: hike.lastDate,
          seats: hike.seats,
        },
      ]
    : []
);
---

<form
  class="hike-booking"
  data-hike-booking
  data-hikes={JSON.stringify(hikes)}
  data-labels={JSON.stringify(t)}
  data-paypal={business.paypalMe}
  novalidate
>
  <div class="hike-booking-fields">
    <fieldset class="field field-wide booking-step">
      <legend><span class="step-num">1</span>{t.stepHike}</legend>
      <div class="hike-options">
        {
          options.map(({ hike, title, level, details = [] }) => (
            <label class:list={['hike-option', { 'is-soon': !hike }]}>
              <input type="radio" name="hike" value={hike?.slug ?? ''} disabled={!hike} />
              <span class="hike-option-title">{title}</span>
              {level && <span class="hike-option-level">{level}</span>}
              <span class="hike-option-details">
                {details.map((detail) => <span>{detail}</span>)}
              </span>
              <span class="hike-option-price">
                {hike ? t.perPerson.replace('{price}', money(hike.pricePerPerson)) : t.comingSoon}
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="field field-wide booking-step">
      <legend><span class="step-num">2</span>{t.stepMonth}</legend>
      <p class="booking-step-hint" data-month-hint>{t.chooseHikeFirst}</p>
      <div class="month-tabs" data-month-tabs></div>
    </fieldset>

    <fieldset class="field field-wide booking-step">
      <legend><span class="step-num">3</span>{t.stepDay}</legend>
      <p class="booking-step-hint" data-day-hint>{t.chooseHikeFirst}</p>
      <div class="date-row" data-date-chips></div>
      <div class="date-status" data-date-status hidden>
        <ul></ul>
        <p>{t.statusNote}</p>
      </div>
    </fieldset>

    <div class="field-wide booking-step-title"><span class="step-num">4</span>{t.stepGroup}</div>

    <p class="field-wide booking-step-hint">{t.onePerson}</p>

    <label class="field field-wide">
      <span>{t.name} *</span>
      <input type="text" name="name" autocomplete="name" required />
    </label>

    <label class="field">
      <span>{t.age} *</span>
      <input type="number" name="age" min="1" max="99" inputmode="numeric" required />
    </label>

    <label class="field">
      <span>{t.idNumber} *</span>
      <input type="text" name="idNumber" required />
    </label>

    <label class="field field-wide">
      <span>{t.home} *</span>
      <input type="text" name="home" autocomplete="address-level2" required />
    </label>

    <label class="field field-wide field-check" data-meal-option hidden>
      <input type="checkbox" name="meal" />
      <span>{t.mealOption} — <span data-meal-price></span></span>
    </label>

    <label class="field">
      <span>{t.whatsapp} *</span>
      <input type="tel" name="whatsapp" autocomplete="tel" required />
    </label>

    <label class="field">
      <span>{t.email} *</span>
      <input type="email" name="email" autocomplete="email" required />
    </label>

    <label class="field">
      <span>{t.lodging} {t.optional}</span>
      <input type="text" name="lodging" />
    </label>

    <label class="field">
      <span>{t.language}</span>
      <select name="language">
        {t.languages.map((language, i) => <option value={labels.fr.languages[i]} selected={i === languageIndex}>{language}</option>)}
      </select>
    </label>

    <label class="field field-wide">
      <span>{t.experience} *</span>
      <select name="experience" required>
        <option value="">{t.experienceChoose}</option>
        {t.experienceOptions.map((option, i) => <option value={labels.fr.experienceOptions[i]}>{option}</option>)}
      </select>
    </label>

    <label class="field field-wide">
      <span>{t.health} {t.optional}</span>
      <textarea name="health" rows="3"></textarea>
    </label>

    <label class="field">
      <span>{t.emergencyName} *</span>
      <input type="text" name="emergencyName" required />
    </label>

    <label class="field">
      <span>{t.emergencyPhone} *</span>
      <input type="tel" name="emergencyPhone" required />
    </label>

    {/* Honeypot: hidden from people, filled in by bots — see hike-book. */}
    <input type="text" name="website" tabindex="-1" autocomplete="off" hidden />

    <label class="field field-wide field-check">
      <input type="checkbox" name="checkInsurance" required />
      <span>{t.checkInsurance}</span>
    </label>

    <label class="field field-wide field-check">
      <input type="checkbox" name="checkWaiver" required />
      <span>{t.checkWaiver}</span>
    </label>

    <label class="field field-wide field-check">
      <input type="checkbox" name="checkTerms" required />
      <span>{t.checkTerms}</span>
    </label>
  </div>

  <aside class="hike-booking-summary" aria-live="polite">
    <div class="section-label">{t.summary}</div>
    <dl>
      <div><dt>{t.summaryHike}</dt><dd data-summary="hike">—</dd></div>
      <div><dt>{t.summaryDate}</dt><dd data-summary="date">—</dd></div>
      <div><dt>{t.summaryMeeting}</dt><dd data-summary="meeting">—</dd></div>
      <div data-summary-meal hidden><dt>{t.summaryMeal}</dt><dd data-summary="meal">—</dd></div>
      <div><dt>{t.summaryTotal}</dt><dd data-summary="total">—</dd></div>
      <div><dt>{t.summaryDeposit}</dt><dd data-summary="deposit">—</dd></div>
      <div><dt>{t.summaryBalance}</dt><dd data-summary="balance">—</dd></div>
    </dl>
    <p class="hike-booking-error" data-booking-error hidden>{t.error}</p>
    <button type="submit" class="btn btn-normal" data-send>{t.send}</button>
    <p class="hike-booking-note" data-send-note>{t.note}</p>
    <div class="hike-booking-done" data-booking-done hidden>
      <div class="section-label">{t.doneTitle}</div>
      <p data-done-text></p>
      <a class="btn" data-another-person>{t.anotherPerson}</a>
    </div>
  </aside>
</form>

<script>
  import '../scripts/hike-booking.js';
</script>
