---
import type { HikeOption } from '../data/guidedHikes';
import { business } from '../data/business';
import type { Locale } from '../i18n/ui';

interface Props {
  options: HikeOption[];
  locale: Locale;
}

const { options, locale } = Astro.props;

// Three steps — hike, month, day — then the participant's details. Submitting
// holds the seat as "pending" (netlify/functions/hike-book) and emails the
// booking to us through Netlify Forms (public/__forms.html). We then send the
// guest the payment link ourselves. See scripts/hike-booking.js.
// Form wording per language. `languages` and `experienceOptions` keep the
// same order in every language: we always read the booking email in French,
// so each option's value is its French wording, whatever the page's language.
