---
import { useTranslations } from '../i18n/utils';
import { defaultLocale, type Locale } from '../i18n/ui';
import { business } from '../data/business';
import { pageHref } from '../data/pageTranslations';
import ReserveContactBlock from './ReserveContactBlock.astro';

interface Props {
  locale?: Locale;
  reserveLabel?: string;
  reserveHeading?: string;
  reserveDescription?: string;
}

const { locale = defaultLocale, reserveLabel, reserveHeading, reserveDescription } = Astro.props;
const t = useTranslations(locale);
const faqHref = pageHref('faq', locale);
const contactHref = pageHref('contact', locale);
const legalHref = pageHref('legal-notice', locale);
---

<footer>
  <div class="footer-top">
    <div class="container footer-top-grid">
      <div class="footer-left">
        <slot />
      </div>
      <div class="footer-right">
        <ReserveContactBlock
          locale={locale}
          label={reserveLabel}
          heading={reserveHeading}
          description={reserveDescription ?? t('reserve.pitch')}
        />
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-inner">
      <div>{t('footer.copyright')}</div>
      <div class="footer-links">
        <a href={faqHref}>{t('footer.faq')}</a>
        <a href={contactHref}>{t('footer.contact')}</a>
        <a href={legalHref}>{t('footer.legalNotice')}</a>
        <a href={business.social.facebook}>{t('footer.facebook')}</a>
        <a href={business.social.instagram}>{t('footer.instagram')}</a>
        <a href={business.social.youtube}>{t('footer.youtube')}</a>
      </div>
    </div>
  </div>
</footer>
