---
import { useTranslations } from '../i18n/utils';
import { defaultLocale, type Locale } from '../i18n/ui';
import { business } from '../data/business';
import ReserveContactBlock from './ReserveContactBlock.astro';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);
---

<footer>
  <div class="footer-top">
    <div class="container footer-top-grid">
      <div class="footer-left">
        <slot />
      </div>
      <div class="footer-right">
        <ReserveContactBlock locale={locale} description={t('reserve.pitch')} />
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-inner">
      <div>{t('footer.copyright')}</div>
      <div class="footer-links">
        <a href={business.social.facebook}>{t('footer.facebook')}</a>
        <a href={business.social.instagram}>{t('footer.instagram')}</a>
        <a href={business.social.youtube}>{t('footer.youtube')}</a>
      </div>
    </div>
  </div>
</footer>
