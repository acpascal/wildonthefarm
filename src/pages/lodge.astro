---
import { getImage, Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import PhotoHero from '../components/PhotoHero.astro';
import Section from '../components/Section.astro';
import Split from '../components/Split.astro';
import { img } from '../lib/images';

const heroImage = img('stay/hero_cabin_exterior.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const cabins = [
  {
    slug: 'cabin-1',
    label: 'Cabin One',
    heading: 'Deepest into the mist.',
    description:
      'The most enclosed of the three, wrapped in bamboo and forest, with a bathroom finished entirely in hand-painted leaf tile.',
    image: img('cabin1/hero.jpg'),
  },
  {
    slug: 'cabin-2',
    label: 'Cabin Two',
    heading: 'Raised above the valley.',
    description:
      'Overlooking the farm and the entire valley, this cabin in the treetops holds the finest view of Volcán Barú.',
    image: img('cabin2/hero.jpg'),
  },
  {
    slug: 'cabin-3',
    label: 'Cabin Three',
    heading: 'The most intricate of the three.',
    description:
      'A one-of-a-kind Versailles parquet floor, inlaid with different woods, paired with a bathroom in superb hand-made ceramic tile.',
    image: img('cabin3/hero.jpg'),
  },
];

const amenities = [
  'Private ensuite bathroom',
  'High-end bedding',
  'Private terrace',
  'Living roof',
  'Solar power',
  'Spring water',
  'No Wi-Fi or TV in cabin, by design',
  'Wi-Fi available in common areas',
];
---

<PageLayout
  title="The Lodge — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Three handcrafted cabins built into the cloud forest of Boquete, Panama — living roofs, private terraces, and views over Amistad National Park."
  path="/lodge/"
  image={ogImage.src}
  pullIntro="I designed this architecture with one concern above all: blending each building into the landscape. But it was my years living in traditional dwellings that taught me a living roof isn't just beautiful — it also shields against the weather and softens the sound of rain."
>
  <Fragment slot="hero">
    <PhotoHero
      image={heroImage}
      alt="Cabin exterior grown into the cloud forest at Wild on the Farm"
      eyebrow="The Lodge"
    >
      Three cabins, blended into the harmony of the cloud forest.
    </PhotoHero>
  </Fragment>

  <Section label="Wherever You Stay" heading="Off-grid comfort, without compromise.">
    <div class="amenity-list">
      {amenities.map((item) => <span>{item}</span>)}
    </div>
    {
      cabins.map((cabin, i) => (
        <Split divider reverse={i === 1}>
          <a href={`/${cabin.slug}/`} class="split-photo">
            <Image
              src={cabin.image}
              alt={`${cabin.label} exterior at Wild on the Farm`}
              widths={[400, 700, 1000]}
              sizes="(min-width: 860px) 50vw, 100vw"
              loading="lazy"
            />
          </a>
          <div>
            <div class="section-label">{cabin.label}</div>
            <h2 class="lede">{cabin.heading}</h2>
            <p>{cabin.description}</p>
            <a href={`/${cabin.slug}/`} class="btn btn-spaced">
              See All of {cabin.label}
            </a>
          </div>
        </Split>
      ))
    }
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Not Sure Which One?</div>
    <h2>Tell us how you'd like to spend your days.</h2>
    <p>Write to us and we'll help you choose the cabin that fits your stay best.</p>
    <div class="contact-list">
      <a href="/farm/">Back to The Farm →</a>
      <a href="/food/">The Food →</a>
    </div>
  </Fragment>
</PageLayout>
