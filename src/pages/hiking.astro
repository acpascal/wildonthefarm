---
import { getImage, Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import PhotoHero from '../components/PhotoHero.astro';
import Section from '../components/Section.astro';
import Split from '../components/Split.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import NoteBox from '../components/NoteBox.astro';
import HikeBooking from '../components/HikeBooking.astro';
import { amistadWildCrossing, cloudForestWaterfall, farmTourCloudForest, type HikeOption } from '../data/guidedHikes';
import { business } from '../data/business';
import { img } from '../lib/images';
import type { PhotoItem } from '../lib/photos';

const heroImage = img('hiking/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const amenities = [
  'Guided or self-guided',
  'Direct access to Amistad park',
  'Primary cloud forest',
  'Monkeys & birdlife en route',
  'Sturdy boots recommended',
];

const amistadFacts = ["For experienced hikers", "About 11 km", "Elevation gain: 850 m", "Start: Pianista, 1,268 m", "High point: 1,918 m", "Finish: Wild on the Farm, 1,730 m", "Guide required", "2 to 6 people", "Gourmet picnic included", "Drive back to Boquete", "Accident insurance required"];

const waterfallFacts = ["Moderate", "About 6.5 km", "Elevation gain: 400 m", "Start: Camino del Español", "High point: 1,918 m", "Steep slopes", "2 to 6 people", "Monday and Thursday", "Gourmet picnic included"];

const farmTourFacts = ["For all hikers", "About 4 hours", "Elevation gain: 200 m", "Start: bottom of the farm, 1,700 m", "High point: 1,918 m", "Steep slopes", "2 to 6 people", "Friday", "Optional meal"];

// The booking form's three hikes, in the order of the sections above it.
const hikeOptions: HikeOption[] = [
  { hike: amistadWildCrossing, title: 'Amistad Wild Crossing', level: "For experienced hikers", details: ["11 km · 850 m elevation gain", "Sunday and Wednesday, 8 am", "Start at El Pianista · gourmet picnic included"] },
  { hike: cloudForestWaterfall, title: 'Cloud Forest and Waterfall', level: "Moderate", details: ["6.5 km · 400 m elevation gain", "Monday and Thursday, 9 am", "Start at Camino del Español · gourmet picnic included"] },
  { hike: farmTourCloudForest, title: 'Farm Tour and Cloud Forest', level: "For all hikers", details: ["About 4 h · 200 m elevation gain", "Friday, 9 am", "Start at the bottom of the farm · optional meal"] },
];

const amistadMaps = [
  { image: img('hiking/amistad-wild-crossing-map.webp'), alt: "Map of the Amistad Wild Crossing route, from Pianista to Wild on the Farm" },
  { image: img('hiking/amistad-wild-crossing-relief.webp'), alt: "Relief view of the Amistad Wild Crossing route through the forest" },
];

const waterfallMaps = [{ image: img('hiking/cloud-forest-waterfall-map.webp'), alt: "Map of the Cloud Forest and Waterfall loop, from the Camino del Español to the ridges above Wild on the Farm" }];

const farmTourMaps = [
  { image: img('hiking/farm-tour-cloud-forest-relief.webp'), alt: "Relief view of the Farm Tour and Cloud Forest loop, above the farm" },
  { image: img('hiking/farm-tour-cloud-forest-above.webp'), alt: "The Farm Tour and Cloud Forest loop seen from above, from the farm to the cloud forest" },
];

const trailPhotos: PhotoItem[] = [
  { image: img('hiking/video-poster-en.jpg'), alt: 'Video: a 4-hour hike from Wild on the Farm', size: 'tall', video: '/videos/hike-4h-en.mp4' },
  { image: img('hiking/gallery_24.jpg'), alt: 'A waterfall pouring into a pool, framed by ferns and moss', size: 'lg' },
  { image: img('hiking/gallery_03.jpg'), alt: 'A narrow trail through dense cloud forest', size: 'tall' },
  { image: img('hiking/gallery_01.jpg'), alt: 'The trail entering the cloud forest', size: 'lg' },
  { image: img('hiking/gallery_32.jpg'), alt: 'Smelling a wild chanterelle mushroom found along the trail', size: 'tall' },
  { image: img('hiking/gallery_36.jpg'), alt: 'A guide standing among giant moss-covered trees in the mist', size: 'lg' },
  { image: img('hiking/gallery_47.jpg'), alt: 'A family making their way down a steep forest trail', size: 'tall' },
  { image: img('hiking/gallery_02.jpg'), alt: 'Moss-covered trees along the trail' },
  { image: img('hiking/gallery_07.jpg'), alt: 'A misty stretch of the hiking trail', size: 'lg' },
  { image: img('hiking/gallery_39.jpg'), alt: 'Giant glossy leaves in the cloud forest understory' },
  { image: img('hiking/gallery_43.jpg'), alt: 'The farm dog leading the way through the misty forest', size: 'lg' },
  { image: img('hiking/gallery_05.jpg'), alt: 'View over the cloud forest canopy from the trail', size: 'wide' },
  { image: img('hiking/gallery_09.jpg'), alt: 'The trail winding through the forest', size: 'tall' },
  { image: img('hiking/gallery_51.jpg'), alt: 'A hiker on a fallen trunk looking out over the forested ridge', size: 'tall' },
  { image: img('hiking/gallery_37.jpg'), alt: 'A hiker climbing past a moss-covered trunk' },
  { image: img('hiking/gallery_04.jpg'), alt: 'Ferns and undergrowth beside the trail' },
  { image: img('hiking/gallery_12.jpg'), alt: 'Wide view of the forest from the trail', size: 'wide' },
  { image: img('hiking/gallery_41.jpg'), alt: 'The guide walking ahead with his staff, the dog close behind' },
  { image: img('hiking/gallery_06.jpg'), alt: 'Sunlight filtering through the cloud forest' },
  { image: img('hiking/gallery_14.jpg'), alt: 'The trail beneath the forest canopy', size: 'lg' },
  { image: img('hiking/gallery_46.jpg'), alt: 'A hiker standing between two enormous cloud forest trunks', size: 'lg' },
  { image: img('hiking/gallery_15.jpg'), alt: 'A steep section of the hiking trail' },
  { image: img('hiking/gallery_16.jpg'), alt: 'Tree ferns along the trail', size: 'tall' },
  { image: img('hiking/gallery_11.jpg'), alt: 'A quiet section of the cloud forest trail' },
  { image: img('hiking/gallery_49.jpg'), alt: 'A huge trunk and hanging vines in the mist', size: 'wide' },
  { image: img('hiking/gallery_44.jpg'), alt: 'The guide smiling among the tree ferns' },
  { image: img('hiking/gallery_17.jpg'), alt: 'A stream crossing on the trail' },
  { image: img('wildlife/mantled_howler_monkey.jpg'), alt: 'A mantled howler monkey spotted along the trail' },
  { image: img('hiking/gallery_18.jpg'), alt: 'View across the Chiriquí highlands from the trail', size: 'wide' },
