---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import Split from '../../components/Split.astro';
import NoteBox from '../../components/NoteBox.astro';
import { img } from '../../lib/images';

const heroImage = img('kitchen/dining_room.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });
const gardenTeaserImage = img('garden/garden_view.jpg');
const gardenTeaserOptimized = await getImage({ src: gardenTeaserImage, width: 800, format: 'webp' });

const diningPhotos = [
  { image: img('kitchen/dining_room.jpg'), alt: 'The dining room at Wild on the Farm, set for a meal' },
  { image: img('kitchen/dining_room_detail.jpg'), alt: "Detail of the dining room's timber furnishings" },
];

const kitchenPhotos = [
  { image: img('kitchen/kitchen_wide.jpg'), alt: 'Wide view of the farm kitchen' },
  { image: img('kitchen/cook_at_work.jpg'), alt: 'The cook preparing a meal in the farm kitchen' },
];

const tablePhotos = [
  { image: img('kitchen/table_guests_1.jpg'), alt: 'Guests sharing a meal at the communal table' },
  { image: img('kitchen/table_guests_2.jpg'), alt: 'Guests seated together at the communal table' },
];

const foodPhotos = [
  { image: img('food/chicken_stew.jpg'), alt: 'A chicken stew made with farm-grown vegetables' },
  { image: img('food/roasted_tomatoes.jpg'), alt: 'Roasted tomatoes from the garden' },
  { image: img('food/plated_dish.jpg'), alt: 'A plated dish served at Wild on the Farm' },
  { image: img('food/four_salads.jpg'), alt: 'Four seasonal salads made from garden produce' },
  { image: img('food/salad_with_view.jpg'), alt: 'A fresh salad served with a view over the cloud forest' },
];
---

<PageLayout
  title="La Comida — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Una cocina de finca en funcionamiento en Wild on the Farm, Boquete: productos orgánicos de nuestros propios huertos en terrazas, cocinados con sencillez y compartidos en una larga mesa."
  path="/es/comida/"
  image={ogImage.src}
  pullIntro="Compartir una comida alrededor de una larga mesa —mezclando idiomas y culturas en un pequeño y hermoso instante de humanidad— es lo mejor que esta montaña tiene para ofrecer. El fuego crepita, y los platos que nos encanta cocinar buscan el equilibrio entre el placer, la salud y la diversidad. La ortiga y la verdolaga son exquisitas, de una fuerza silenciosa: lo entenderás en cuanto su aroma te llegue por la puerta de la cocina. Me encanta cocinar. Para mí es una aventura nueva cada día, moldeada por el huerto, el clima y lo que sea que me inspire esa mañana. Esta es la cocina de Pachapapa…."
  locale="es"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="El comedor de Wild on the Farm" eyebrow="La Comida">
      La cocina de Pachapapa.
    </PageHero>
  </Fragment>

  <Section label="El Comedor" heading="Donde termina el día.">
    <PhotoGrid items={diningPhotos} groupId="kitchen-dining" />
  </Section>

  <Section label="La Cocina" heading="Pequeña, profesional, y siempre en uso.">
    <PhotoGrid items={kitchenPhotos} groupId="kitchen-kitchen" />
  </Section>

  <Section label="Alrededor De La Mesa" heading="Todos comen juntos.">
    <PhotoGrid items={tablePhotos} groupId="kitchen-table" />
  </Section>

  <Section label="Desde Nuestro Huerto" heading="Orgánico, de temporada, a pocos pasos de la estufa.">
    <p>
      Con el corazón latiendo hasta el último pulso, el huerto guarda dieciocho años de
      experimentación y experiencia. Nutrimos la tierra, y la tierra a su vez nutre las plantas
      que te llevan su vitalidad. Cualquier otro camino le hace daño a tu salud.
    </p>
    <Split>
      <div class="story-img" style={`background-image:url(${gardenTeaserOptimized.src})`} role="img" aria-label="Vista sobre los huertos en terrazas" />
      <div>
        <p>
          El Huerto ahora tiene su propia página — fotos completas de la terraza a la mesa, y la
          historia de permacultura detrás de todo.
        </p>
        <p><a href="/es/jardin/"><strong>Visita El Huerto →</strong></a></p>
      </div>
    </Split>
  </Section>

  <Section label="Lo Que Cocinamos" heading="Comida sencilla, cocinada para nutrir.">
    <p>
      Aquí las comidas siguen al huerto en lugar de un menú fijo — guisos abundantes, verduras
      asadas, y ensaladas frescas armadas con lo que esté listo para cosechar esa mañana. El
      objetivo es una comida que sepa al lugar donde creció, y que haga que los huéspedes se
      sientan mejor de lo que llegaron.
    </p>
    <PhotoGrid items={foodPhotos} groupId="kitchen-food" />
    <NoteBox variant="todo">
      <p>
        Placeholder frame for the "cultures and health" angle — replace with real words on why we
        grow and cook this way (organic practices, permaculture, health philosophy).
      </p>
    </NoteBox>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Planifica Tu Visita</div>
    <h2>¿Ya tienes hambre?</h2>
    <div class="contact-list">
      <a href="/es/finca/">La Finca →</a>
      <a href="/es/lodge/">La Estancia →</a>
    </div>
  </Fragment>
</PageLayout>
