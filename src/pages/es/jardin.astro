---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { img } from '../../lib/images';

const heroImage = img('journal/macadamia/macadamia_permaculture_01.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const gardenPhotos = [
  { image: heroImage, alt: 'Permaculture terraces beneath the macadamia trees' },
  { image: img('garden/garden_harvest.jpg'), alt: 'A basket of freshly harvested vegetables from the garden' },
  { image: img('garden/garden_artichokes.jpg'), alt: 'Artichokes growing in the terraced garden' },
  { image: img('garden/garden_chard.jpg'), alt: 'Rows of chard growing in the garden' },
  { image: img('garden/garden_kale.jpg'), alt: 'Kale growing in the terraced beds' },
  { image: img('garden/garden_rows.jpg'), alt: 'Rows of vegetables in the terraced garden' },
  { image: img('garden/garden_terrace_trellis.jpg'), alt: 'A trellis on one of the garden terraces' },
  { image: img('garden/garden_peas.jpg'), alt: 'Pea vines growing in the garden' },
  { image: img('garden/garden_herb_bed.jpg'), alt: 'A stone-walled herb bed in the garden' },
  { image: img('garden/garden_terraces_flowers.jpg'), alt: 'Flowering terraces in the garden' },
];
---

<PageLayout
  title="El Huerto — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Huertos orgánicos en terrazas en Wild on the Farm, Boquete Cloud Forest Lodge — acelga, kale, hinojo, alcachofas y hierbas, cultivados sin insumos químicos en una finca de permacultura en el bosque nuboso de Panamá."
  path="/es/jardin/"
  image={ogImage.src}
  pullIntro="Los propios huertos en terrazas de la finca abastecen la mayor parte de lo que se cocina aquí — acelga, kale, hinojo, alcachofas, zanahorias, tomates y hierbas, cultivados sin insumos químicos y cosechados el mismo día en que se comen."
  locale="es"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Terrazas de permacultura bajo los árboles de macadamia" eyebrow="El Huerto">
      Orgánico, de temporada, a pocos pasos de la estufa.
    </PageHero>
  </Fragment>

  <Section label="Desde Nuestro Huerto" heading="Las terrazas detrás de la cocina.">
    <PhotoGrid items={gardenPhotos} groupId="garden" />
  </Section>

  <Section label="Construido Sobre Permacultura" heading="Los mismos principios detrás de los árboles de macadamia.">
    <p>
      Estas terrazas funcionan con la misma filosofía de insumo cero que el resto de la finca —
      sin fertilizantes sintéticos ni pesticidas, solo compost, nuestros propios abonos
      fermentados, y dieciocho años de trabajar con la montaña en lugar de contra ella.
    </p>
    <p><a href="/es/journal/vision-francesa-de-boquete/"><strong>Lee la historia de permacultura de la finca →</strong></a></p>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Planifica Tu Visita</div>
    <h2>Descubre de dónde viene todo.</h2>
    <div class="contact-list">
      <a href="/es/comida/">La Comida →</a>
      <a href="/es/finca/">La Finca →</a>
    </div>
  </Fragment>
</PageLayout>
