---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import { business } from '../../data/business';
import { img } from '../../lib/images';
import { mailtoHref } from '../../i18n/utils';

const heroImage = img('farm/property_overview.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });
---

<PageLayout
  title="Contacto — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Cómo contactar a Wild on the Farm, Boquete Cloud Forest Lodge, directamente por WhatsApp o correo."
  path="/es/contacto/"
  image={ogImage.src}
  pullIntro="¿Tienes una pregunta que no está en las Preguntas Frecuentes? Simplemente escríbenos directamente."
  locale="es"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Vista aérea de la propiedad de la finca" eyebrow="Ponte En Contacto">
      Cómo contactarnos.
    </PageHero>
  </Fragment>

  <Section label="Ponte En Contacto" heading="Respondemos WhatsApp más rápido que el correo.">
    <div class="contact-list contact-list-lg">
      <a href={business.whatsappHref}>{business.phone} (WhatsApp)</a>
      <a href={mailtoHref(business.email, 'es')}>{business.email}</a>
    </div>
  </Section>

  <Section label="Encuéntranos" heading="Dónde encontrarnos en Boquete.">
    <div class="map-embed">
      <iframe
        title="Ubicación de Wild on the Farm en Google Maps"
        width="100%"
        height="450"
        style="border:0"
        loading="lazy"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3942.6012169702753!2d-82.45058332498353!3d8.823481391229862!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa5edd18b24f369%3A0x11b58604931f7e19!2sWild%20on%20the%20farm!5e0!3m2!1sfr!2spa!4v1787767091890!5m2!1sfr!2spa"
      />
    </div>
    <div class="contact-list">
      <a href="https://www.google.com/maps?cid=1276073423635709465">Ver nuestras reseñas en Google →</a>
    </div>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Antes De Preguntar</div>
    <h2>Consulta las Preguntas Frecuentes — tu duda podría estar ya resuelta.</h2>
    <div class="contact-list">
      <a href="/es/preguntas-frecuentes/">Preguntas Frecuentes →</a>
      <a href="/es/tarifas-y-retiros/">Tarifas y Retiros →</a>
      <a href="/es/lodge/">Ver Las Cabañas →</a>
    </div>
  </Fragment>
</PageLayout>
