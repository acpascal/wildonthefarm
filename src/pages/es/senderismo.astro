  { image: img('hiking/gallery_33.jpg'), alt: 'Una flor rosa intenso en el sotobosque del bosque nuboso', size: 'tall' },
  { image: img('hiking/gallery_29.jpg'), alt: 'Una excursionista trepando un tramo embarrado y lleno de raíces' },
  { image: img('hiking/gallery_31.jpg'), alt: 'Un excursionista con mochila roja abriéndose paso entre helechos y musgo colgante' },
  { image: img('hiking/gallery_28.jpg'), alt: 'Excursionistas subiendo un sendero empinado bajo árboles cubiertos de musgo', size: 'tall' },
  { image: img('hiking/gallery_45.jpg'), alt: 'Los brazos alzados hacia el dosel del bosque nuboso' },
  { image: img('hiking/gallery_52.jpg'), alt: 'Una familia entre los helechos arborescentes, con un pequeño en portabebés' },
  { image: img('hiking/gallery_35.jpg'), alt: 'Grupos de hongos silvestres blancos en la hierba junto al sendero', size: 'wide' },
