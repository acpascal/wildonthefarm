const hikeOptions: HikeOption[] = [
  { hike: amistadWildCrossing, title: 'Amistad Wild Crossing', level: "Para senderistas experimentados", details: ["11 km · 850 m de desnivel", "Domingo y miércoles, 8 a. m.", "Salida en El Pianista · picnic gourmet incluido"] },
  { hike: cloudForestWaterfall, title: 'Cloud Forest and Waterfall', level: "Dificultad moderada", details: ["6,5 km · 400 m de desnivel", "Lunes y jueves, 9 a. m.", "Salida en el Camino del Español · picnic gourmet incluido"] },
  { hike: farmTourCloudForest, title: 'Farm Tour and Cloud Forest', level: "Para todos los senderistas", details: ["Unas 4 h · 200 m de desnivel", "Viernes, 9 a. m.", "Salida en la parte baja de la finca · comida opcional"] },
];

const amistadMaps = [
  { image: img('hiking/amistad-wild-crossing-map.webp'), alt: "Mapa del recorrido Amistad Wild Crossing, de Pianista a Wild on the Farm" },
  { image: img('hiking/amistad-wild-crossing-relief.webp'), alt: "Vista en relieve del recorrido Amistad Wild Crossing a través del bosque" },
