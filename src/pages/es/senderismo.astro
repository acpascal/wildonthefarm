const waterfallMaps = [{ image: img('hiking/cloud-forest-waterfall-map.webp'), alt: "Mapa del circuito Cloud Forest and Waterfall, del Camino del Español a las crestas sobre Wild on the Farm" }];

const farmTourMaps = [
