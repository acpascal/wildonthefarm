  { image: img('hiking/gallery_07.jpg'), alt: 'Un tramo neblinoso del sendero', size: 'lg' },
  { image: img('hiking/gallery_39.jpg'), alt: 'Hojas gigantes y brillantes en el sotobosque del bosque nuboso' },
  { image: img('hiking/gallery_43.jpg'), alt: 'El perro de la finca abriendo camino por el bosque brumoso', size: 'lg' },
