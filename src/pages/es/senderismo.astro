const amistadFacts = ["Para senderistas experimentados", "Unos 11 km", "Desnivel: 850 m", "Salida: Pianista, 1.268 m", "Punto más alto: 1.918 m", "Llegada: Wild on the Farm, 1.730 m", "Guía indispensable", "De 2 a 6 personas", "Picnic gourmet incluido", "Regreso en carro a Boquete", "Seguro de accidentes obligatorio"];

const waterfallFacts = ["Dificultad moderada", "Unos 6,5 km", "Desnivel: 400 m", "Salida: Camino del Español", "Punto más alto: 1.918 m", "Pendientes fuertes", "De 2 a 6 personas", "Lunes y jueves", "Picnic gourmet incluido"];

const farmTourFacts = ["Para todos los senderistas", "Unas 4 horas", "Desnivel: 200 m", "Salida: parte baja de la finca, 1.700 m", "Punto más alto: 1.918 m", "Pendientes fuertes", "De 2 a 6 personas", "Viernes", "Comida opcional"];

