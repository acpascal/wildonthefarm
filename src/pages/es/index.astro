---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import Stats from '../../components/Stats.astro';
import Section from '../../components/Section.astro';
import Split from '../../components/Split.astro';
import Story from '../../components/Story.astro';
import CardGrid from '../../components/CardGrid.astro';
import TextCard from '../../components/TextCard.astro';
import OverlayCard from '../../components/OverlayCard.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import SchemaLodging from '../../components/SchemaLodging.astro';
import { business } from '../../data/business';
import { img } from '../../lib/images';

const heroImage = img('home/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const stats = [
  { num: "5,905'", label: 'Elevación' },
  { num: 'Tres', label: 'Cabañas en el Bosque Nuboso' },
  { num: 'Desde 2008', label: 'Finca Orgánica y de Macadamia' },
  { num: 'Amistad', label: 'Parque Nacional' },
];

const pillars = [
  { title: 'Autenticidad', description: 'Dieciocho años de agricultura orgánica bien real — aquí, nada es un decorado pensado para los turistas.' },
  { title: 'Intimidad', description: 'Tres cabañas, ni una más. Una elección asumida, no una limitación.' },
  { title: 'Silencio', description: 'Las nubes, la altitud, y un silencio que casi se siente físicamente.' },
  { title: 'Confort Sin Artificios', description: 'Vivir fuera de la red no significa renunciar al confort — ropa de cama cuidada, baño privado, madera cálida.' },
  { title: 'Una Mesa Viva', description: 'Comidas nacidas a pocos pasos de donde se sirven.' },
];

const cards = [
  {
    href: '/es/lodge/',
    image: img('stay/card_cloud_forest_cabins.jpg'),
    label: 'El Lodge',
    title: 'Cabañas en el Bosque Nuboso',
    description: 'Madera cálida, vistas de suelo a techo, y un silencio construido para el descanso.',
  },
  {
    href: '/es/comida/',
    image: img('food/four_salads.jpg'),
    label: 'La Comida',
    title: 'De Nuestro Jardín',
    description: 'Orgánica, de temporada, cosechada a pocos pasos de la mesa.',
  },
  {
    href: '/es/avistamiento-de-aves/',
    image: img('birds/bird_14.jpg'),
    label: 'Experiencia',
    title: 'Avistamiento de Aves y Senderos',
    description: 'Hogar del Quetzal Resplandeciente y los senderos del Parque Amistad.',
  },
];
---

<PageLayout
  title={`${business.name} — ${business.tagline}`}
  description={business.description}
  path="/es/"
  image={ogImage.src}
  locale="es"
>
  <Fragment slot="hero">
    <Hero
      image={heroImage}
      alt="Cabaña con vista al bosque nuboso en Wild on the Farm"
      title={business.name}
      tagline={business.tagline}
      eyebrow="Finca de Permacultura y Macadamia Orgánica desde 2008"
      focalPosition="center 50%"
    >
      <p>
        Tres cabañas secretas. Una finca orgánica. Frente al volcán Barú, vive el lujo en estado
        salvaje.
      </p>
      <div class="hero-cta">
        <a href="/es/reservar/" class="btn btn-inverted">Reserva Tu Estancia</a>
        <a href="/es/finca/" class="btn btn-transparent">Descubre La Finca</a>
      </div>
    </Hero>
  </Fragment>

  <Stats stats={stats} />

  <Section>
    <Split>
      <div>
        <div class="section-label">La Finca</div>
        <h2 class="lede">Dieciocho años de tierra nutricia, mucho antes de que llegara el primer huésped.</h2>
      </div>
      <div>
        <p>
          Donde las brumas del bosque nuboso envuelven los secretos de la tierra, la elegancia
          discreta de nuestro refugio se convierte en el espejo eterno de la naturaleza salvaje.
          En el corazón de nuestra finca orgánica, el prestigio de un confort absoluto se une a la
          autenticidad orgánica para reinventar el arte de vivir en la cumbre.
        </p>
      </div>
    </Split>
  </Section>

  <Story dark image={img('home/story.jpg')} alt="Un techo vivo en Wild on the Farm" label="Una Arquitectura Que Escucha la Tierra" heading="Techos nacidos de la propia ladera.">
    <p>
      Los techos vivos borran la frontera entre el refugio y la pendiente: construidos en madera
      tropical sostenible, se anclan en la montaña en lugar de simplemente posarse sobre ella. La
      energía solar, el agua de manantial y un suelo vivo hacen de este refugio algo
      autosuficiente — aquí, el confort y el respeto por lo vivo son una sola cosa.
    </p>
  </Story>

  <Section label="Lo Esencial" heading="Cinco principios que nunca sacrificamos.">
    <CardGrid cols={5}>
      {pillars.map((p) => (
        <TextCard lite title={p.title}>
          <p>{p.description}</p>
        </TextCard>
      ))}
    </CardGrid>
  </Section>

  <Section label="Explora" heading="Alójate, come y explora — al ritmo de la finca.">
    <CardGrid>
      {cards.map((c) => <OverlayCard {...c} />)}
    </CardGrid>
    <div class="map-embed">
      <iframe
        title="Ubicación de Wild on the Farm en Google Maps"
        width="100%"
        height="450"
        style="border:0"
        loading="lazy"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3942.6012169702753!2d-82.45058332498353!3d8.823481391229862!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa5edd18b24f369%3A0x11b58604931f7e19!2sWild%20on%20the%20farm!5e0!3m2!1sfr!2spa!4v1787767091890!5m2!1sfr!2spa"
      />
    </div>
    <div class="contact-list">
      <a href="https://www.google.com/maps?cid=1276073423635709465">Ver nuestras reseñas en Google →</a>
    </div>
  </Section>

  <QuoteSection cite="— Charlotte Hamilton">
    "Me alojé en Wild on the Farm y realmente reconecté con lo que importa. El silencio de aquí
    tiene una textura que no se olvida."
  </QuoteSection>

  <Fragment slot="footer">
    <div class="section-label">Diario</div>
    <h2>Desde la finca, cada semana.</h2>
    <p>
      Notas de temporada sobre las plantas del país, el estado de los senderos, la permacultura y
      la vida de esta pequeña montaña — actualizadas al ritmo de sus propias estaciones.
    </p>
    <div class="contact-list">
      <a href="/es/journal/">Leer El Diario →</a>
    </div>
  </Fragment>

  <SchemaLodging imageUrl={ogImage.src} />
</PageLayout>
