---
import { getImage } from 'astro:assets';
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Section from '../../../components/Section.astro';
import ReserveCTA from '../../../components/ReserveCTA.astro';
import ReserveContactBlock from '../../../components/ReserveContactBlock.astro';
import { img } from '../../../lib/images';
import { getJournal, groupBySection, slugFromId } from '../../../lib/journal';

const heroImage = img('farm/overview_1.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const entries = await getJournal('es');
const sections = groupBySection(entries);

const sectionCopy = {
  'what-we-grow': {
    label: 'Lo Que Cultivamos',
    heading: 'Lo que cultivamos, y para qué sirve.',
    intro:
      'Perfiles de plantas con sus propiedades medicinales y terapéuticas, usos culinarios, y cómo cultivarlas tú mismo.',
    bg: undefined as 'cream' | undefined,
  },
  'farm-notes': {
    label: 'Notas de la Finca',
    heading: 'La vida en la montaña, semana a semana.',
    intro: 'Guías de viaje, condiciones de senderos, y lo que valga la pena compartir desde la finca.',
    bg: 'cream' as const,
  },
  'travel-panama': {
    label: 'Viajes por Panamá',
    heading: 'Historias y guías más allá de Boquete.',
    intro: 'Experiencias y notas de viaje por todo el país — no solo la finca, sino el resto del Panamá salvaje.',
    bg: undefined as 'cream' | undefined,
  },
};
---

<PageLayout
  title="Diario — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Notas de temporada y perfiles de plantas de Wild on the Farm, Boquete Cloud Forest Lodge — propiedades medicinales, usos culinarios, y cómo cultivamos lo que crece a 1,800m en el bosque nuboso de Panamá."
  path="/es/journal/"
  image={ogImage.src}
  pullIntro="Perfiles de las plantas que cultivamos — sus usos medicinales y culinarios, y cómo cultivarlas — junto con notas de temporada sobre senderos, especies nativas, y la vida de esta pequeña montaña."
  locale="es"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Vista general de la finca" eyebrow="El Diario">
      Desde la finca, cada semana.
    </PageHero>
  </Fragment>

  {
    sections.map(([key, items], i) =>
      items.length > 0 && (
        <Section noPadTop={i === 0} bg={sectionCopy[key].bg} label={sectionCopy[key].label} heading={sectionCopy[key].heading}>
          <p>{sectionCopy[key].intro}</p>
          <div class="text-card-grid">
            {items.map((entry) => (
              <div class="text-card">
                <h3><a href={`/es/journal/${slugFromId(entry.id)}/`}>{entry.data.title}</a></h3>
                <p>{entry.data.description}</p>
              </div>
            ))}
          </div>
        </Section>
      )
    )
  }

  <Section bg="cream" label="Síguenos" heading="Nuevas publicaciones, también en Instagram.">
    <p>
      Cada nueva publicación del Diario se comparte en Instagram al publicarse — síguenos ahí para
      enterarte apenas un nuevo perfil de planta o nota de la finca esté disponible.
    </p>
    <div class="contact-list">
      <a href="https://www.instagram.com/wildonthefarm">@wildonthefarm en Instagram →</a>
    </div>
  </Section>

  <ReserveCTA>
    <Fragment slot="left">
      <div class="section-label">Cerca de la Finca</div>
      <h2>Nuevas notas, cada miércoles.</h2>
      <p>Desde plantas nativas hasta el estado de los senderos — un registro continuo de esta pequeña montaña.</p>
      <div class="contact-list">
        <a href="/the-farm/">La Finca →</a>
        <a href="/birdwatching/">Avistamiento de Aves →</a>
      </div>
    </Fragment>
    <Fragment slot="right">
      <ReserveContactBlock locale="es" />
    </Fragment>
  </ReserveCTA>
</PageLayout>
