---
import { getImage } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import ReserveContactBlock from '../components/ReserveContactBlock.astro';
import { img } from '../lib/images';

const heroImage = img('journal/macadamia/macadamia_permaculture_01.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const gardenPhotos = [
  { image: heroImage, alt: 'Permaculture terraces beneath the macadamia trees' },
  { image: img('garden/garden_harvest.jpg'), alt: 'A basket of freshly harvested vegetables from the garden' },
  { image: img('garden/garden_artichokes.jpg'), alt: 'Artichokes growing in the terraced garden' },
  { image: img('garden/garden_chard.jpg'), alt: 'Rows of chard growing in the garden' },
  { image: img('garden/garden_kale.jpg'), alt: 'Kale growing in the terraced beds' },
  { image: img('garden/garden_rows.jpg'), alt: 'Rows of vegetables in the terraced garden' },
  { image: img('garden/garden_terrace_trellis.jpg'), alt: 'A trellis on one of the garden terraces' },
  { image: img('garden/garden_peas.jpg'), alt: 'Pea vines growing in the garden' },
  { image: img('garden/garden_herb_bed.jpg'), alt: 'A stone-walled herb bed in the garden' },
  { image: img('garden/garden_terraces_flowers.jpg'), alt: 'Flowering terraces in the garden' },
];
---

<PageLayout
  title="The Garden — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Terraced organic gardens at Wild on the Farm, Boquete Cloud Forest Lodge — chard, kale, fennel, artichokes, and herbs, grown without chemical inputs on a permaculture farm in Panama's cloud forest."
  path="/garden/"
  image={ogImage.src}
  pullIntro="The farm's own terraced beds supply most of what's cooked here — chard, kale, fennel, artichokes, carrots, tomatoes, and herbs, grown without chemical inputs and picked the same day they're eaten."
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Permaculture terraces beneath the macadamia trees" eyebrow="The Garden">
      Organic, seasonal, a few steps from the stove.
    </PageHero>
  </Fragment>

  <Section noPadTop label="From Our Garden" heading="The terraces behind the kitchen.">
    <PhotoGrid items={gardenPhotos} groupId="garden" />
  </Section>

  <Section label="Built On Permaculture" heading="The same principles behind the macadamia trees.">
    <p>
      These terraces run on the same zero-input philosophy as the rest of the farm — no synthetic
      fertilizers or pesticides, just compost, our own fermented plant feeds, and eighteen years
      of working with the mountain instead of against it.
    </p>
    <p><a href="/journal/french-visionary-of-boquete/"><strong>Read the farm's permaculture story →</strong></a></p>
  </Section>

  <ReserveCTA>
    <Fragment slot="left">
      <div class="section-label">Plan Your Visit</div>
      <h2>See where it all comes from.</h2>
      <div class="contact-list">
        <a href="/kitchen/">The Kitchen →</a>
        <a href="/the-farm/">The Farm →</a>
      </div>
    </Fragment>
    <Fragment slot="right">
      <ReserveContactBlock />
    </Fragment>
  </ReserveCTA>
</PageLayout>
