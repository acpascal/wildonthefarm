---
import { getImage } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Section from '../components/Section.astro';
import Split from '../components/Split.astro';
import Story from '../components/Story.astro';
import CardGrid from '../components/CardGrid.astro';
import TextCard from '../components/TextCard.astro';
import OverlayCard from '../components/OverlayCard.astro';
import QuoteSection from '../components/QuoteSection.astro';
import SchemaLodging from '../components/SchemaLodging.astro';
import { business } from '../data/business';
import { img } from '../lib/images';

const heroImage = img('home/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const stats = [
  { num: "5,905'", label: 'Elevation' },
  { num: 'Three', label: 'Cloud Forest Cabins' },
  { num: 'Est. 2008', label: 'Organic & Macadamia Farm' },
  { num: 'Amistad', label: 'National Park' },
];

const pillars = [
  { title: 'Authenticity', description: 'Eighteen years of real organic farming — nothing here is a backdrop staged for tourists.' },
  { title: 'Intimacy', description: 'Three cabins, not one more. A deliberate choice, not a limitation.' },
  { title: 'Silence', description: 'The clouds, the altitude, and a silence you can almost feel on your skin.' },
  { title: 'Comfort Without Artifice', description: "Living off-grid doesn't mean giving up comfort — considered bedding, a private bath, warm timber." },
  { title: 'A Living Table', description: "Meals born just steps from where they're served." },
];

const cards = [
  {
    href: '/lodge/',
    image: img('stay/card_cloud_forest_cabins.jpg'),
    label: 'The Lodge',
    title: 'Cloud Forest Cabins',
    description: 'Warm timber, floor-to-ceiling views, and a silence built for rest.',
  },
  {
    href: '/food/',
    image: img('food/four_salads.jpg'),
    label: 'The Food',
    title: 'From Our Garden',
    description: 'Organic, seasonal, harvested a few steps from the table.',
  },
  {
    href: '/birdwatching/',
    image: img('birds/bird_14.jpg'),
    label: 'Experience',
    title: 'Birdwatching & Trails',
    description: 'Home to the Resplendent Quetzal and the trails of Amistad park.',
  },
];

---

<PageLayout title={`${business.name} — ${business.tagline}`} description={business.description} path="/" image={ogImage.src}>
  <Fragment slot="hero">
    <Hero
      image={heroImage}
      alt="Cabin overlooking the cloud forest at Wild on the Farm"
      title={business.name}
      tagline={business.tagline}
      eyebrow="Permaculture & Organic Macadamia Farm since 2008"
      focalPosition="center 50%"
    >
      <p>
        Three secret cabins. One organic farm. Facing Volcán Barú, live luxury in the wild.
      </p>
      <div class="hero-cta">
        <a href="/faqs-contact/" class="btn btn-inverted">Reserve Your Stay</a>
        <a href="/farm/" class="btn btn-transparent">Discover the Farm</a>
      </div>
    </Hero>
  </Fragment>

  <Stats stats={stats} />

  <Section>
    <Split>
      <div>
        <div class="section-label">The Farm</div>
        <h2 class="lede">Eighteen years of nourishing ground, long before the first guest ever arrived.</h2>
      </div>
      <div>
        <p>
          Where the mists of the cloud forest cloak the secrets of the earth, the hushed elegance
          of our refuge becomes the eternal mirror of the wild. At the heart of our organic farm,
          the prestige of absolute comfort unites with organic authenticity to reinvent the art
          of living at the summit.
        </p>
      </div>
    </Split>
  </Section>

  <Story dark image={img('home/story.jpg')} alt="A living roof at Wild on the Farm" label="An Architecture That Listens to the Land" heading="Roofs born from the hillside itself.">
    <p>
      Living roofs erase the line between shelter and slope: built from sustainable tropical
      hardwood, they root into the mountain rather than merely resting on it. Solar power,
      spring water, and living soil make this refuge self-sufficient — here, comfort and
      reverence for the living world are one and the same.
    </p>
  </Story>

  <Section label="What Matters Most" heading="Five principles we never sacrifice.">
    <CardGrid cols={5}>
      {pillars.map((p) => (
        <TextCard lite title={p.title}>
          <p>{p.description}</p>
        </TextCard>
      ))}
    </CardGrid>
  </Section>

  <Section label="Explore" heading="Stay, eat, and explore — at the farm's own pace.">
    <CardGrid>
      {cards.map((c) => <OverlayCard {...c} />)}
    </CardGrid>
    <div class="map-embed">
      <iframe
        title="Wild on the Farm location on Google Maps"
        width="100%"
        height="450"
        style="border:0"
        loading="lazy"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3942.6012169702753!2d-82.45058332498353!3d8.823481391229862!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa5edd18b24f369%3A0x11b58604931f7e19!2sWild%20on%20the%20farm!5e0!3m2!1sfr!2spa!4v1787767091890!5m2!1sfr!2spa"
      />
    </div>
    <div class="contact-list">
      <a href="https://www.google.com/maps?cid=1276073423635709465">See our reviews on Google →</a>
    </div>
  </Section>

  <QuoteSection cite="— Charlotte Hamilton">
    "I stayed at Wild on the Farm and truly reconnected with what matters. The silence here has a
    texture you don't forget."
  </QuoteSection>

  <Fragment slot="footer">
    <div class="section-label">Journal</div>
    <h2>From the farm, every week.</h2>
    <p>
      Seasonal notes on native plants, trail conditions, permaculture, and the life of this
      small mountain — updated with its own changing seasons.
    </p>
    <div class="contact-list">
      <a href="/journal/">Read The Journal →</a>
    </div>
  </Fragment>

  <SchemaLodging imageUrl={ogImage.src} />
</PageLayout>
