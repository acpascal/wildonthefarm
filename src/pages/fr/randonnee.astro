  { image: img('hiking/gallery_39.jpg'), alt: 'Des feuilles géantes et luisantes dans le sous-bois de la forêt nuageuse' },
  { image: img('hiking/gallery_43.jpg'), alt: 'Le chien de la ferme ouvrant la marche dans la forêt brumeuse', size: 'lg' },
  { image: img('hiking/gallery_05.jpg'), alt: 'Vue sur la canopée de la forêt nuageuse depuis le sentier', size: 'wide' },
  { image: img('hiking/gallery_09.jpg'), alt: 'Le sentier serpentant à travers la forêt', size: 'tall' },
  { image: img('hiking/gallery_51.jpg'), alt: 'Un randonneur sur un tronc couché, face à la crête boisée', size: 'tall' },
  { image: img('hiking/gallery_37.jpg'), alt: "Un randonneur grimpant près d'un tronc couvert de mousse" },
  { image: img('hiking/gallery_04.jpg'), alt: 'Fougères et sous-bois en bordure du sentier' },
  { image: img('hiking/gallery_12.jpg'), alt: 'Vue large de la forêt depuis le sentier', size: 'wide' },
  { image: img('hiking/gallery_41.jpg'), alt: 'Le guide marchant devant avec son bâton, le chien sur ses talons' },
