    details: ['6,5 km · 400 m de dénivelé', 'Lundi et jeudi, 9 h', 'Départ Camino del Español · pique-nique gourmet inclus'],
  },
  {
    hike: farmTourCloudForest,
    title: 'Farm Tour and Cloud Forest',
    level: 'Pour tous les randonneurs',
    details: ['Environ 4 h · 200 m de dénivelé', 'Le vendredi, 9 h', 'Départ en bas de la ferme · repas en option'],
  },
];

const waterfallFacts = [
  'Difficulté modérée',
  'Environ 6,5 km',
  'Dénivelé : 400 m',
  'Départ : Camino del Español',
  'Point haut : 1 918 m',
  'Fortes pentes',
  'De 2 à 6 personnes',
  'Lundi et jeudi',
  'Pique-nique gourmet inclus',
];

const waterfallMap = {
  image: img('hiking/cloud-forest-waterfall-map.webp'),
  alt: 'Carte de la boucle Cloud Forest and Waterfall, du Camino del Español aux crêtes au-dessus de Wild on the Farm',
};

const farmTourFacts = [
  'Pour tous les randonneurs',
  'Environ 4 heures',
  'Dénivelé : 200 m',
  'Départ : en bas de la ferme, 1 700 m',
  'Point haut : 1 918 m',
  'Fortes pentes',
  'De 2 à 6 personnes',
  'Le vendredi',
  'Repas en option',
];

const farmTourMaps = [
  { image: img('hiking/farm-tour-cloud-forest-relief.webp'), alt: 'Vue en relief de la boucle du Farm Tour and Cloud Forest, au-dessus de la ferme' },
  { image: img('hiking/farm-tour-cloud-forest-above.webp'), alt: 'La boucle du Farm Tour and Cloud Forest vue du dessus, de la ferme à la forêt nuageuse' },
];

const amistadMaps = [
  { image: img('hiking/amistad-wild-crossing-map.webp'), alt: "Carte du tracé de l'Amistad Wild Crossing, du Pianista à Wild on the Farm" },
  { image: img('hiking/amistad-wild-crossing-relief.webp'), alt: "Vue en relief du tracé de l'Amistad Wild Crossing à travers la forêt" },
];

const trailPhotos: PhotoItem[] = [
  { image: img('hiking/video-poster-fr.jpg'), alt: 'Vidéo : randonnée de 4 heures au départ de Wild on the Farm', size: 'tall', video: '/videos/hike-4h-fr.mp4' },
  { image: img('hiking/gallery_24.jpg'), alt: 'Une cascade se jetant dans un bassin, entre fougères et mousses', size: 'lg' },
  { image: img('hiking/gallery_03.jpg'), alt: 'Un sentier étroit à travers la forêt nuageuse dense', size: 'tall' },
  { image: img('hiking/gallery_01.jpg'), alt: 'Le sentier entrant dans la forêt nuageuse', size: 'lg' },
  { image: img('hiking/gallery_32.jpg'), alt: 'Humer une girolle sauvage trouvée le long du sentier', size: 'tall' },
  { image: img('hiking/gallery_36.jpg'), alt: "Un guide au milieu d'arbres géants couverts de mousse, dans la brume", size: 'lg' },
  { image: img('hiking/gallery_47.jpg'), alt: 'Une famille descendant un sentier raide en forêt', size: 'tall' },
