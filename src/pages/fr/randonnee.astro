  { image: img('hiking/gallery_43.jpg'), alt: 'Le chien de la ferme ouvrant la marche dans la forêt brumeuse', size: 'lg' },
  { image: img('hiking/gallery_05.jpg'), alt: 'Vue sur la canopée de la forêt nuageuse depuis le sentier', size: 'wide' },
  { image: img('hiking/gallery_09.jpg'), alt: 'Le sentier serpentant à travers la forêt', size: 'tall' },
  { image: img('hiking/gallery_51.jpg'), alt: 'Un randonneur sur un tronc couché, face à la crête boisée', size: 'tall' },
  { image: img('hiking/gallery_37.jpg'), alt: "Un randonneur grimpant près d'un tronc couvert de mousse" },
  { image: img('hiking/gallery_04.jpg'), alt: 'Fougères et sous-bois en bordure du sentier' },
  { image: img('hiking/gallery_12.jpg'), alt: 'Vue large de la forêt depuis le sentier', size: 'wide' },
  { image: img('hiking/gallery_41.jpg'), alt: 'Le guide marchant devant avec son bâton, le chien sur ses talons' },
  { image: img('hiking/gallery_06.jpg'), alt: 'La lumière filtrant à travers la forêt nuageuse' },
  { image: img('hiking/gallery_14.jpg'), alt: 'Le sentier sous la canopée', size: 'lg' },
  { image: img('hiking/gallery_46.jpg'), alt: 'Un randonneur debout entre deux énormes troncs de la forêt nuageuse', size: 'lg' },
  { image: img('hiking/gallery_15.jpg'), alt: 'Une portion escarpée du sentier' },
  { image: img('hiking/gallery_16.jpg'), alt: 'Des fougères arborescentes le long du sentier', size: 'tall' },
  { image: img('hiking/gallery_11.jpg'), alt: 'Une portion paisible du sentier en forêt nuageuse' },
  { image: img('hiking/gallery_49.jpg'), alt: 'Un tronc immense et des lianes pendantes dans la brume', size: 'wide' },
  { image: img('hiking/gallery_44.jpg'), alt: 'Le guide souriant au milieu des fougères arborescentes' },
  { image: img('hiking/gallery_17.jpg'), alt: 'Une traversée de ruisseau sur le sentier' },
