  { image: img('hiking/gallery_36.jpg'), alt: "Un guide au milieu d'arbres géants couverts de mousse, dans la brume", size: 'lg' },
  { image: img('hiking/gallery_47.jpg'), alt: 'Une famille descendant un sentier raide en forêt', size: 'tall' },
