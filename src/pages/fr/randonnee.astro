  { image: img('hiking/gallery_46.jpg'), alt: 'Un randonneur debout entre deux énormes troncs de la forêt nuageuse', size: 'lg' },
  { image: img('hiking/gallery_15.jpg'), alt: 'Une portion escarpée du sentier' },
  { image: img('hiking/gallery_16.jpg'), alt: 'Des fougères arborescentes le long du sentier', size: 'tall' },
  { image: img('hiking/gallery_11.jpg'), alt: 'Une portion paisible du sentier en forêt nuageuse' },
  { image: img('hiking/gallery_49.jpg'), alt: 'Un tronc immense et des lianes pendantes dans la brume', size: 'wide' },
  { image: img('hiking/gallery_44.jpg'), alt: 'Le guide souriant au milieu des fougères arborescentes' },
