  { image: img('hiking/gallery_40.jpg'), alt: 'Un randonneur gravissant une pente raide au milieu des fougères', size: 'tall' },
  { image: img('hiking/gallery_50.jpg'), alt: 'Un randonneur tout petit parmi les grands arbres, dans une brume épaisse', size: 'lg' },
  { image: img('hiking/gallery_19.jpg'), alt: 'Sous-bois dense en bordure du sentier' },
  { image: img('hiking/gallery_08.jpg'), alt: 'Des broméliacées sur un arbre en bordure du sentier' },
  { image: img('hiking/gallery_21.jpg'), alt: 'Un tronc moussu en bordure du sentier', size: 'tall' },
  { image: img('hiking/gallery_22.jpg'), alt: 'Le sentier s\'enfonçant plus profondément dans la forêt nuageuse', size: 'lg' },
