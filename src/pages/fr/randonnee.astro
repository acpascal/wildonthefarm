---
import { getImage, Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import Section from '../../components/Section.astro';
import Split from '../../components/Split.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import NoteBox from '../../components/NoteBox.astro';
import HikeBooking from '../../components/HikeBooking.astro';
import { amistadWildCrossing, cloudForestWaterfall, farmTourCloudForest, type HikeOption } from '../../data/guidedHikes';
import { business } from '../../data/business';
import { img } from '../../lib/images';
import type { PhotoItem } from '../../lib/photos';

const heroImage = img('hiking/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const amenities = [
  'Guidée ou en autonomie',
  'Accès direct au parc La Amistad',
  'Forêt nuageuse primaire',
  'Singes et oiseaux sur le chemin',
  'Chaussures de marche solides recommandées',
];

const amistadFacts = [
  'Randonneurs confirmés',
  'Environ 11 km',
  'Dénivelé : 850 m',
  'Départ : Pianista, 1 268 m',
  'Point haut : 1 918 m',
  'Arrivée : Wild on the Farm, 1 730 m',
  'Guide indispensable',
  'De 2 à 6 personnes',
  'Pique-nique gourmet inclus',
  'Retour en voiture à Boquete',
  'Assurance accident obligatoire',
];

// The booking form's three hikes, in the order of the sections above it.
const hikeOptions: HikeOption[] = [
  {
    hike: amistadWildCrossing,
    title: 'Amistad Wild Crossing',
    level: 'Randonneurs confirmés',
    details: ['11 km · 850 m de dénivelé', 'Dimanche et mercredi, 8 h', 'Départ El Pianista · pique-nique gourmet inclus'],
  },
  {
    hike: cloudForestWaterfall,
    title: 'Cloud Forest and Waterfall',
