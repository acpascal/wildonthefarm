---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import Stats from '../../components/Stats.astro';
import Section from '../../components/Section.astro';
import Split from '../../components/Split.astro';
import Story from '../../components/Story.astro';
import CardGrid from '../../components/CardGrid.astro';
import TextCard from '../../components/TextCard.astro';
import OverlayCard from '../../components/OverlayCard.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import SchemaLodging from '../../components/SchemaLodging.astro';
import { business } from '../../data/business';
import { img } from '../../lib/images';

const heroImage = img('home/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const stats = [
  { num: "5,905'", label: 'Altitude' },
  { num: 'Trois', label: 'Cabanes en Forêt Nuageuse' },
  { num: 'Depuis 2008', label: 'Ferme Biologique et de Macadamia' },
  { num: 'Amistad', label: 'Parc National' },
];

const pillars = [
  { title: 'Authenticité', description: "Dix-huit ans d'agriculture biologique bien réelle — ici, rien n'est un décor pensé pour les touristes." },
  { title: 'Intimité', description: 'Trois cabanes, pas une de plus. Un choix assumé, pas une contrainte.' },
  { title: 'Silence', description: 'Les nuages, l’altitude, et un silence qui se ressent presque physiquement.' },
  { title: 'Confort sans artifice', description: 'Vivre hors réseau ne veut pas dire renoncer au confort — literie soignée, salle de bain privée, bois chaleureux.' },
  { title: 'Une table vivante', description: 'Des repas nés à quelques pas de là où on les sert.' },
];

const cards = [
  {
    href: '/fr/lodge/',
    image: img('stay/card_cloud_forest_cabins.jpg'),
    label: 'Le Lodge',
    title: 'Cabanes en Forêt Nuageuse',
    description: 'Bois chaleureux, vues du sol au plafond, et un silence conçu pour le repos.',
  },
  {
    href: '/fr/cuisine/',
    image: img('food/four_salads.jpg'),
    label: 'La Cuisine',
    title: 'De Notre Jardin',
    description: 'Biologique, de saison, récoltée à quelques pas de la table.',
  },
  {
    href: '/fr/observation-des-oiseaux/',
    image: img('birds/bird_14.jpg'),
    label: 'Expérience',
    title: 'Observation des Oiseaux et Sentiers',
    description: 'Le refuge du Quetzal Resplendissant et des sentiers du parc Amistad.',
  },
];
---

<PageLayout
  title={`${business.name} — ${business.tagline}`}
  description={business.description}
  path="/fr/"
  image={ogImage.src}
  locale="fr"
>
  <Fragment slot="hero">
    <Hero
      image={heroImage}
      alt="Cabane surplombant la forêt nuageuse à Wild on the Farm"
      title={business.name}
      tagline={business.tagline}
      eyebrow="Ferme de Permaculture et de Macadamia Biologique depuis 2008"
      focalPosition="center 50%"
    >
      <p>
        Trois cabanes secrètes. Une ferme biologique. Face au volcan Barú, vivez le luxe à l'état
        sauvage.
      </p>
      <div class="hero-cta">
        <a href="/fr/reserver/" class="btn btn-inverted">Réservez Votre Séjour</a>
        <a href="/fr/ferme/" class="btn btn-transparent">Découvrez la Ferme</a>
      </div>
    </Hero>
  </Fragment>

  <Stats stats={stats} />

  <Section>
    <Split>
      <div>
        <div class="section-label">La Ferme</div>
        <h2 class="lede">Dix-huit années de terre nourricière, bien avant l'arrivée du premier hôte.</h2>
      </div>
      <div>
        <p>
          Là où les brumes de la forêt nébuleuse enveloppent les secrets de la terre, l'élégance
          feutrée de notre refuge devient le miroir éternel de la nature sauvage. Au cœur de notre
          ferme biologique, le prestige d'un confort absolu s'unit à l'authenticité organique pour
          réinventer l'art de vivre au sommet.
        </p>
      </div>
    </Split>
  </Section>

  <Story dark image={img('home/story.jpg')} alt="Un toit végétalisé à Wild on the Farm" label="Une Architecture Qui Écoute la Terre" heading="Des toits nés à même la colline.">
    <p>
      Les toits végétalisés effacent la frontière entre l'abri et la pente : construits en bois
      tropical durable, ils s'ancrent dans la montagne plutôt que de s'y poser. L'énergie solaire,
      l'eau de source et un sol vivant rendent ce refuge autonome — ici, le confort et le respect
      du vivant ne font qu'un.
    </p>
  </Story>

  <Section label="L'Essentiel" heading="Cinq principes que nous ne sacrifions jamais.">
    <CardGrid cols={5}>
      {pillars.map((p) => (
        <TextCard lite title={p.title}>
          <p>{p.description}</p>
        </TextCard>
      ))}
    </CardGrid>
  </Section>

  <Section label="Explorer" heading="Séjournez, mangez et explorez — au rythme de la ferme.">
    <CardGrid>
      {cards.map((c) => <OverlayCard {...c} />)}
    </CardGrid>
    <div class="map-embed">
      <iframe
        title="Emplacement de Wild on the Farm sur Google Maps"
        width="100%"
        height="450"
        style="border:0"
        loading="lazy"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3942.6012169702753!2d-82.45058332498353!3d8.823481391229862!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa5edd18b24f369%3A0x11b58604931f7e19!2sWild%20on%20the%20farm!5e0!3m2!1sfr!2spa!4v1787767091890!5m2!1sfr!2spa"
      />
    </div>
    <div class="contact-list">
      <a href="https://www.google.com/maps?cid=1276073423635709465">Voir nos avis sur Google →</a>
    </div>
  </Section>

  <QuoteSection cite="— Charlotte Hamilton">
    "Je suis restée à Wild on the Farm et j'ai vraiment renoué avec l'essentiel. Le silence, ici, a
    une texture qu'on n'oublie pas."
  </QuoteSection>

  <Fragment slot="footer">
    <div class="section-label">Journal</div>
    <h2>Depuis la ferme, chaque semaine.</h2>
    <p>
      Des notes de saison sur les plantes du pays, l'état des sentiers, la permaculture et la vie
      de cette petite montagne — mises à jour au fil de ses propres saisons.
    </p>
    <div class="contact-list">
      <a href="/fr/journal/">Lire Le Journal →</a>
    </div>
  </Fragment>

  <SchemaLodging imageUrl={ogImage.src} />
</PageLayout>
