---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { img } from '../../lib/images';

const heroImage = img('cabin3/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const photos = [
  { image: heroImage, alt: 'Intérieur de la Cabane Jaguar' },
  { image: img('cabin3/gallery_1.jpg'), alt: 'Tête de lit sculptée à la main dans la Cabane Jaguar' },
  { image: img('cabin3/gallery_2.jpg'), alt: 'Salle de bain de la Cabane Jaguar, carrelage Art Nouveau peint à la main' },
  { image: img('cabin3/gallery_3.jpg'), alt: 'Détail de la chambre de la Cabane Jaguar' },
  { image: img('cabin3/gallery_4.jpg'), alt: "Détail de l'intérieur de la Cabane Jaguar" },
  { image: img('cabin3/gallery_5.jpg'), alt: 'Linge de lit à motifs botaniques de la Cabane Jaguar' },
];

const amenities = [
  'Salle de bain privée en suite',
  'Carrelage Art Nouveau peint à la main',
  'Tête de lit sculptée à la main',
  'Literie haut de gamme',
  'Toit végétalisé',
  'Pas de Wi-Fi ni de télévision, par choix',
];
---

<PageLayout
  title="Cabane Jaguar — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="La Cabane Jaguar à Wild on the Farm : une tête de lit sculptée à la main, des tissus botaniques, et une salle de bain habillée de carrelage Art Nouveau peint à la main."
  path="/fr/cabane-3/"
  image={ogImage.src}
  pullIntro="La Cabane Jaguar cultive le détail — une tête de lit en bois sculptée à la main, du linge de lit à motifs botaniques, et une salle de bain habillée du sol au plafond de carrelage Art Nouveau peint à la main. La plus raffinée des trois cabanes, sans rien perdre de leur quiétude commune."
  locale="fr"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Intérieur de la Cabane Jaguar" eyebrow="Séjour — Cabane Jaguar">
      La plus raffinée des trois.
    </PageHero>
  </Fragment>

  <Section label="Chaque Recoin" heading="Toute la Cabane Jaguar.">
    <PhotoGrid items={photos} groupId="cabin-3" />
    <div class="amenity-list centered">
      {amenities.map((item) => <span>{item}</span>)}
    </div>
  </Section>

  <Section label="Réservez Votre Séjour">
    <div id="apartmentIframeAll">
      <script is:inline type="text/javascript" src="https://login.smoobu.com/js/Settings/BookingToolIframe.js"></script>
      <script is:inline>
        BookingToolIframe.initialize({
          url: 'https://login.smoobu.com/en/booking-tool/iframe/1880246',
          baseUrl: 'https://login.smoobu.com',
          target: '#apartmentIframeAll',
        });
      </script>
    </div>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Comparer</div>
    <h2>Voir les autres cabanes.</h2>
    <div class="contact-list">
      <a href="/fr/lodge/">Toutes Les Cabanes →</a>
      <a href="/fr/cabane-1/">Cabane Quetzal →</a>
      <a href="/fr/cabane-2/">Cabane Hummingbird →</a>
    </div>
  </Fragment>
</PageLayout>
