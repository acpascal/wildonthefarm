---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import { business } from '../../data/business';
import { img } from '../../lib/images';
import { mailtoHref } from '../../i18n/utils';

const heroImage = img('farm/property_overview.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });
---

<PageLayout
  title="Contact — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Comment joindre Wild on the Farm, Boquete Cloud Forest Lodge, directement par WhatsApp ou e-mail."
  path="/fr/contact/"
  image={ogImage.src}
  pullIntro="Une question qui n'est pas dans la FAQ ? Écrivez-nous directement."
  locale="fr"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Vue aérienne de la propriété" eyebrow="Nous Contacter">
      Comment nous joindre.
    </PageHero>
  </Fragment>

  <Section label="Nous Contacter" heading="Nous répondons plus vite sur WhatsApp que par e-mail.">
    <div class="contact-list contact-list-lg">
      <a href={business.whatsappHref}>{business.phone} (WhatsApp)</a>
      <a href={mailtoHref(business.email, 'fr')}>{business.email}</a>
    </div>
  </Section>

  <Section label="Nous Trouver" heading="Où nous trouver à Boquete.">
    <div class="map-embed">
      <iframe
        title="Emplacement de Wild on the Farm sur Google Maps"
        width="100%"
        height="450"
        style="border:0"
        loading="lazy"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3942.6012169702753!2d-82.45058332498353!3d8.823481391229862!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa5edd18b24f369%3A0x11b58604931f7e19!2sWild%20on%20the%20farm!5e0!3m2!1sfr!2spa!4v1787767091890!5m2!1sfr!2spa"
      />
    </div>
    <div class="contact-list">
      <a href="https://www.google.com/maps?cid=1276073423635709465">Voir nos avis sur Google →</a>
    </div>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Avant De Nous Écrire</div>
    <h2>Consultez la FAQ — votre réponse s'y trouve peut-être déjà.</h2>
    <div class="contact-list">
      <a href="/fr/faq/">FAQ →</a>
      <a href="/fr/tarifs-et-retraites/">Tarifs et Retraites →</a>
      <a href="/fr/lodge/">Voir Les Cabanes →</a>
    </div>
  </Fragment>
</PageLayout>
