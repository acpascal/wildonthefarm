---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { img } from '../../lib/images';

const heroImage = img('cabin1/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const photos = [
  { image: heroImage, alt: 'Extérieur de la Cabane Quetzal dans la forêt nuageuse' },
  { image: img('cabin1/gallery_1.jpg'), alt: 'Intérieur de la Cabane Quetzal' },
  { image: img('cabin1/gallery_2.jpg'), alt: 'Vue depuis le balcon de la Cabane Quetzal' },
  { image: img('cabin1/gallery_3.jpg'), alt: 'Salle de bain de la Cabane Quetzal, carreaux à motifs de feuilles peints à la main' },
];

const amenities = [
  'Salle de bain privée en suite',
  "Douche à l'italienne, carreaux à motifs de feuilles",
  'Literie haut de gamme',
  'Balcon privé',
  'Toit végétalisé',
  'Pas de Wi-Fi ni de télévision, par choix',
];
---

<PageLayout
  title="Cabane Quetzal — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="La Cabane Quetzal à Wild on the Farm : une terrasse privée nichée dans la forêt nuageuse embrumée, avec une douche habillée de carreaux à motifs de feuilles et des intérieurs chaleureux en bois massif."
  path="/fr/cabane-1/"
  image={ogImage.src}
  pullIntro="Installée au plus près de la lisière forestière, la Cabane Quetzal capture la forêt nuageuse dans ce qu'elle a de plus intime — un balcon privé enveloppé de bambou et de brume, et une salle de bain entièrement habillée de carreaux à motifs de feuilles peints à la main."
  locale="fr"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Extérieur de la Cabane Quetzal dans la forêt nuageuse" eyebrow="Séjour — Cabane Quetzal">
      Au plus profond de la brume.
    </PageHero>
  </Fragment>

  <Section label="Chaque Recoin" heading="Toute la Cabane Quetzal.">
    <PhotoGrid items={photos} groupId="cabin-1" />
    <div class="amenity-list centered">
      {amenities.map((item) => <span>{item}</span>)}
    </div>
  </Section>

  <Section label="Réservez Votre Séjour">
    <div id="apartmentIframeAll">
      <script is:inline type="text/javascript" src="https://login.smoobu.com/js/Settings/BookingToolIframe.js"></script>
      <script is:inline>
        BookingToolIframe.initialize({
          url: 'https://login.smoobu.com/en/booking-tool/iframe/1880246',
          baseUrl: 'https://login.smoobu.com',
          target: '#apartmentIframeAll',
        });
      </script>
    </div>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Comparer</div>
    <h2>Voir les autres cabanes.</h2>
    <div class="contact-list">
      <a href="/fr/lodge/">Toutes Les Cabanes →</a>
      <a href="/fr/cabane-2/">Cabane Hummingbird →</a>
      <a href="/fr/cabane-3/">Cabane Jaguar →</a>
    </div>
  </Fragment>
</PageLayout>
