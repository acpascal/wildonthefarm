---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { img } from '../../lib/images';

const heroImage = img('cabin2/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const photos = [
  { image: heroImage, alt: 'La Cabane Hummingbird, perchée sur pilotis au-dessus de la vallée' },
  { image: img('cabin2/gallery_1.jpg'), alt: 'Intérieur de la Cabane Hummingbird' },
  { image: img('cabin2/gallery_2.jpg'), alt: 'Balcon et vue sur la vallée depuis la Cabane Hummingbird' },
  { image: img('cabin2/gallery_3.jpg'), alt: 'Chambre de la Cabane Hummingbird' },
  { image: img('cabin2/gallery_4.jpg'), alt: 'Salle de bain de la Cabane Hummingbird' },
  { image: img('cabin2/gallery_5.jpg'), alt: 'Vue sur la vallée du Chiriquí depuis la Cabane Hummingbird' },
  { image: img('cabin2/gallery_6.jpg'), alt: 'Détail extérieur de la Cabane Hummingbird' },
  { image: img('cabin2/gallery_7.jpg'), alt: 'Terrasse de la Cabane Hummingbird' },
];

const amenities = [
  'Salle de bain privée en suite',
  "Douche à l'italienne, carreaux à motifs de feuilles",
  'Literie haut de gamme',
  'Balcon privé',
  'Vue sur la vallée et le Volcán Barú',
  'Structure surélevée sur pilotis',
  'Pas de Wi-Fi ni de télévision, par choix',
];
---

<PageLayout
  title="Cabane Hummingbird — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="La Cabane Hummingbird à Wild on the Farm : perchée sur pilotis au-dessus de la colline, avec une vue dégagée sur la vallée du Chiriquí, depuis le lit, le balcon, et la douche."
  path="/fr/cabane-2/"
  image={ogImage.src}
  pullIntro="Franchir le seuil de cette cabane, et un « Wow ! » d'émerveillement est la seule réponse possible face à son atmosphère et à sa vue sans pareille. C'est la cabane où suivre le ballet des nuages, et danser avec les étoiles…"
  locale="fr"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="La Cabane Hummingbird, perchée sur pilotis au-dessus de la vallée" eyebrow="Séjour — Cabane Hummingbird">
      Suspendue entre ciel et terre.
    </PageHero>
  </Fragment>

  <Section label="Chaque Recoin" heading="Toute la Cabane Hummingbird.">
    <PhotoGrid items={photos} groupId="cabin-2" />
    <div class="amenity-list centered">
      {amenities.map((item) => <span>{item}</span>)}
    </div>
  </Section>

  <Section label="Réservez Votre Séjour">
    <div id="apartmentIframeAll">
      <script is:inline type="text/javascript" src="https://login.smoobu.com/js/Settings/BookingToolIframe.js"></script>
      <script is:inline>
        BookingToolIframe.initialize({
          url: 'https://login.smoobu.com/en/booking-tool/iframe/1880246',
          baseUrl: 'https://login.smoobu.com',
          target: '#apartmentIframeAll',
        });
      </script>
    </div>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Comparer</div>
    <h2>Voir les autres cabanes.</h2>
    <div class="contact-list">
      <a href="/fr/lodge/">Toutes Les Cabanes →</a>
      <a href="/fr/cabane-1/">Cabane Quetzal →</a>
      <a href="/fr/cabane-3/">Cabane Jaguar →</a>
    </div>
  </Fragment>
</PageLayout>
