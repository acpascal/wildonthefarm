---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Split from '../../components/Split.astro';
import CardGrid from '../../components/CardGrid.astro';
import TextCard from '../../components/TextCard.astro';
import NoteBox from '../../components/NoteBox.astro';
import ReserveContactBlock from '../../components/ReserveContactBlock.astro';
import { img } from '../../lib/images';

const heroImage = img('products/macadamia_harvest.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });
const macadamiaSplitImage = await getImage({ src: heroImage, width: 800, format: 'webp' });
const fertilizerSplitImage = await getImage({ src: img('garden/garden_harvest.jpg'), width: 800, format: 'webp' });
---

<PageLayout
  title="Produits de la Ferme — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Noix de macadamia biologiques et produits de la ferme, cultivés et récoltés à Wild on the Farm, Boquete Cloud Forest Lodge, Panama — commande directe."
  path="/fr/boutique/"
  image={ogImage.src}
  pullIntro="Noix de macadamia, tisanes, confitures, ferments, et un purin de jardin perfectionné en 18 ans — tout est cultivé et préparé à la main sur la ferme, à 1 800 mètres dans la forêt nuageuse du Panama."
  locale="fr"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Noix de macadamia fraîchement récoltées sur la ferme" eyebrow="Produits de la Ferme">
      Tout ce que nous cultivons — et ce que vous pouvez emporter.
    </PageHero>
  </Fragment>

  <Section label="Noix de Macadamia" heading="Cultivées sur la ferme, récoltées à la main.">
    <Split>
      <div>
        <p>
          Nos macadamias font partie de la ferme depuis des années, cultivées de manière
          biologique aux côtés des jardins potagers et de la forêt nuageuse. Chaque récolte est
          cueillie, décortiquée et préparée sur place.
        </p>
        <div class="amenity-list">
          <span>Culture biologique</span>
          <span>Récolte à la main</span>
          <span>De la ferme à votre porte</span>
        </div>
        <NoteBox variant="todo">
          <p>
            Needed: which formats are sold (raw / roasted, shell-on / shelled), bag sizes, prices,
            and whether orders ship beyond Panama or are pickup/on-site only.
          </p>
        </NoteBox>
      </div>
      <div>
        <div class="story-img" style={`background-image:url(${macadamiaSplitImage.src})`} role="img" aria-label="Noix de macadamia fraîchement récoltées" />
      </div>
    </Split>
  </Section>

  <Section label="Tisanes" heading="Deux mélanges, cultivés et séchés sur la ferme.">
    <p>
      Des mélanges de tisanes composés de ce qui pousse sur la ferme — un mélange du matin et un
      mélange du soir. Curieux de chaque ingrédient ? Le Journal consacre une fiche complète à
      chaque plante de ces mélanges, avec ses usages traditionnels.
    </p>
    <CardGrid cols={2}>
      <TextCard title="Mélange du Matin" eyebrow="Jiaogulan, ortie et romarin">
        <p>
          Cultivé et séché sur la ferme. À lire sur le Journal : <a href="/fr/journal/jiaogulan/">le jiaogulan</a>,{' '}
          <a href="/fr/journal/ortie/">l'ortie</a>, et <a href="/fr/journal/romarin/">le romarin</a>.
        </p>
      </TextCard>
      <TextCard title="Mélange du Soir" eyebrow="Jiaogulan, ortie et verveine">
        <p>
          Cultivé et séché sur la ferme. À lire sur le Journal : <a href="/fr/journal/jiaogulan/">le jiaogulan</a>,{' '}
          <a href="/fr/journal/ortie/">l'ortie</a>, et <a href="/fr/journal/verveine/">la verveine</a>.
        </p>
      </TextCard>
    </CardGrid>
    <NoteBox variant="todo">
      <p>Needed: prices, package sizes, and whether these ship or are pickup/on-site only.</p>
    </NoteBox>
  </Section>

  <Section label="Confitures et Ferments" heading="Confitures, soupes, et légumes lacto-fermentés.">
    <p>Des conserves en petites quantités, faites à partir de la récolte du jardin, et de la lacto-fermentation traditionnelle.</p>
    <CardGrid>
      <TextCard title="Confiture de Tomate en Arbre" eyebrow="Tamarillo">
        <p>Une confiture acidulée, légèrement tangy, à base des tomates en arbre de la ferme.</p>
      </TextCard>
      <TextCard title="Soupe à l'Ortie" eyebrow="Ortie">
        <p>Une soupe simple et terreuse, à base d'<a href="/fr/journal/ortie/">ortie</a> cultivée sur la ferme.</p>
      </TextCard>
      <TextCard title="Kimchi et Ferments" eyebrow="Lacto-fermentation">
        <p>
          Notre <a href="/fr/journal/kimchi-du-jardin/">Kimchi du Jardin</a> et d'autres légumes
          lacto-fermentés issus du jardin.
        </p>
      </TextCard>
    </CardGrid>
    <NoteBox variant="todo">
      <p>
        Needed: the rest of the preserves list, plus prices, jar/container sizes, and shipping vs.
        pickup for this section.
      </p>
    </NoteBox>
  </Section>

  <Section label="Purin de Jardin" heading="18 ans d'expérimentation, dans un seul mélange.">
    <Split>
      <div>
        <p>
          Un engrais liquide (« purin ») obtenu par fermentation d'ortie, de consoude et de
          tithonia — un mélange affiné en 18 ans de culture sur cette ferme. Réservé au jardin,
          non comestible.
        </p>
        <div class="amenity-list">
          <span>Ortie</span>
          <span>Consoude</span>
          <span>Tithonia</span>
          <span>18 ans de mise au point</span>
        </div>
      </div>
      <div>
        <div class="story-img" style={`background-image:url(${fertilizerSplitImage.src})`} role="img" aria-label="Légumes récoltés dans le jardin biologique" />
      </div>
    </Split>
    <NoteBox variant="todo">
      <p>Needed: prices, bottle/container sizes, and shipping vs. pickup for the fertilizer too.</p>
    </NoteBox>
  </Section>

  <Section label="Suivez la Dernière Récolte" heading="Retrouvez-nous sur Instagram.">
    <p>
      Pour les photos de récolte du moment, la disponibilité des produits, et ce qui sort de la
      ferme en ce moment, suivez-nous sur Instagram.
    </p>
    <div class="contact-list">
      <a href="https://www.instagram.com/wildonthefarm">@wildonthefarm sur Instagram →</a>
    </div>
  </Section>

  <Section label="Comment Commander" heading="Écrivez-nous directement — pas de commande en ligne.">
    <p>
      Écrivez-nous sur WhatsApp ou par e-mail en précisant ce qui vous intéresse, et nous vous
      confirmerons la disponibilité, le prix, et la façon de recevoir votre commande.
    </p>
  </Section>

  <Fragment slot="footer">
    <ReserveContactBlock label="Commander" heading="Contactez-nous pour passer commande." />
  </Fragment>
</PageLayout>
