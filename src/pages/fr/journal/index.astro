---
import { getImage } from 'astro:assets';
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Section from '../../../components/Section.astro';
import CardGrid from '../../../components/CardGrid.astro';
import TextCard from '../../../components/TextCard.astro';
import { img } from '../../../lib/images';
import { getJournal, groupBySection, slugFromId } from '../../../lib/journal';

const heroImage = img('farm/overview_1.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const entries = await getJournal('fr');
const sections = groupBySection(entries);

const sectionCopy = {
  'what-we-grow': {
    label: 'Ce Que Nous Cultivons',
    heading: 'Ce que nous cultivons, et à quoi ça sert.',
    intro:
      'Fiches de plantes avec leurs propriétés médicinales et thérapeutiques, leurs usages culinaires, et comment les cultiver vous-même.',
  },
  'farm-notes': {
    label: 'Notes de la Ferme',
    heading: 'La vie sur la montagne, semaine après semaine.',
    intro: "Guides de voyage, état des sentiers, et tout ce qui mérite d'être partagé depuis la ferme.",
  },
  'travel-panama': {
    label: 'Voyager au Panama',
    heading: 'Histoires et guides au-delà de Boquete.',
    intro: 'Expériences et carnets de voyage à travers tout le pays — pas seulement la ferme, mais le reste du Panama sauvage.',
  },
};
---

<PageLayout
  title="Journal — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Articles de Wild on the Farm, Boquete Cloud Forest Lodge, sur les fiches de plantes, la vie à la ferme, la randonnée et la faune, le bien-être, et des guides de voyage à Boquete et dans le reste du Panama."
  path="/fr/journal/"
  image={ogImage.src}
  pullIntro="Des fiches sur les plantes que nous cultivons — leurs usages médicinaux et culinaires, et comment les cultiver — ainsi que des notes de saison sur les sentiers, les espèces locales, et la vie de cette petite montagne."
  locale="fr"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Vue d'ensemble de la ferme" eyebrow="Le Journal">
      Depuis la ferme, chaque semaine.
    </PageHero>
  </Fragment>

  {
    sections.map(([key, items], i) =>
      items.length > 0 && (
        <Section label={sectionCopy[key].label} heading={sectionCopy[key].heading}>
          <p>{sectionCopy[key].intro}</p>
          <CardGrid>
            {items.map((entry) => (
              <TextCard title={entry.data.title} href={`/fr/journal/${slugFromId(entry.id)}/`} cta="Lire la suite →">
                {entry.data.description}
              </TextCard>
            ))}
          </CardGrid>
        </Section>
      )
    )
  }

  <Section label="Suivez-Nous" heading="De nouvelles publications, aussi sur Instagram.">
    <p>
      Chaque nouvel article du Journal est partagé sur Instagram dès sa publication — suivez-nous
      là-bas pour être informé dès qu'une nouvelle fiche de plante ou note de la ferme est
      disponible.
    </p>
    <div class="contact-list">
      <a href="https://www.instagram.com/wildonthefarm">@wildonthefarm sur Instagram →</a>
    </div>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Près de la Ferme</div>
    <h2>De nouvelles notes, chaque mercredi.</h2>
    <p>Des plantes locales à l'état des sentiers — un journal continu de cette petite montagne.</p>
    <div class="contact-list">
      <a href="/fr/ferme/">La Ferme →</a>
      <a href="/fr/observation-des-oiseaux/">Observation des Oiseaux →</a>
    </div>
  </Fragment>
</PageLayout>
