---
import { getImage } from 'astro:assets';
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Section from '../../../components/Section.astro';
import { img } from '../../../lib/images';
import JournalSections from '../../../components/JournalSections.astro';

const heroImage = img('farm/overview_1.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });
---

<PageLayout
  title="Journal | Wild on the Farm, Boquete Cloud Forest Lodge"
  description="Articles de Wild on the Farm, Boquete Cloud Forest Lodge, sur les fiches de plantes, la vie à la ferme, la randonnée et la faune, le bien-être, et des guides de voyage à Boquete et dans le reste du Panama."
  path="/fr/journal/"
  image={ogImage.src}
  pullIntro="Des fiches sur les plantes que nous cultivons — leurs usages médicinaux et culinaires, et comment les cultiver — ainsi que des notes de saison sur les sentiers, les espèces locales, et la vie de cette petite montagne."
  locale="fr"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Vue d'ensemble de la ferme" eyebrow="Le Journal">
      Depuis la ferme, chaque semaine.
    </PageHero>
  </Fragment>

  <JournalSections locale="fr" />

  <Section label="Suivez-Nous" heading="De nouvelles publications, aussi sur Instagram.">
    <p>
      Chaque nouvel article du Journal est partagé sur Instagram dès sa publication — suivez-nous
      là-bas pour être informé dès qu'une nouvelle fiche de plante ou note de la ferme est
      disponible.
    </p>
    <div class="contact-list">
      <a href="https://www.instagram.com/wildonthefarm">@wildonthefarm sur Instagram →</a>
    </div>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Près de la Ferme</div>
    <h2>De nouvelles notes, chaque mercredi.</h2>
    <p>Des plantes locales à l'état des sentiers — un journal continu de cette petite montagne.</p>
    <div class="contact-list">
      <a href="/fr/ferme/">La Ferme →</a>
      <a href="/fr/observation-des-oiseaux/">Observation des Oiseaux →</a>
    </div>
  </Fragment>
</PageLayout>
