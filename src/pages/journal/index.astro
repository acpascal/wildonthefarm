---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import CardGrid from '../../components/CardGrid.astro';
import TextCard from '../../components/TextCard.astro';
import { img } from '../../lib/images';
import { getJournal, groupBySection, slugFromId } from '../../lib/journal';
import { pageAlternates } from '../../data/pageTranslations';

const heroImage = img('farm/overview_1.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const entries = await getJournal('en');
const sections = groupBySection(entries);

const sectionCopy = {
  'what-we-grow': {
    label: 'What We Grow',
    heading: 'What we grow, and what it’s good for.',
    intro:
      'Plant profiles covering medicinal and therapeutic properties, culinary interest, and how to grow each one yourself — plus the bigger stories behind what comes out of this farm.',
  },
  'farm-notes': {
    label: 'Farm Notes',
    heading: 'Life on the mountain, week to week.',
    intro: 'Travel guides, trail conditions, Qi Gong and wellness, and whatever else is worth sharing from the farm.',
  },
  'travel-panama': {
    label: 'Travel Panama',
    heading: 'Stories and guides from beyond Boquete.',
    intro: 'Experiences and travel notes from across the country — not just the farm, but the rest of wild Panama.',
  },
};
---

<PageLayout
  title="Journal — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Articles from Wild on the Farm, Boquete Cloud Forest Lodge, on plant profiles, farm life, hiking and wildlife, wellness, and travel guides to Boquete and the rest of Panama."
  path="/journal/"
  image={ogImage.src}
  pullIntro="Plant profiles from what we grow — their medicinal and culinary uses, and how to cultivate them — alongside seasonal notes on trail conditions, native species, and the health of this small mountain."
  alternates={pageAlternates('journal')}
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Overview of the farm property" eyebrow="The Journal">
      From the farm, every week.
    </PageHero>
  </Fragment>

  {
    sections.map(([key, items], i) =>
      items.length > 0 && (
        <Section label={sectionCopy[key].label} heading={sectionCopy[key].heading}>
          <p>{sectionCopy[key].intro}</p>
          <CardGrid>
            {items.map((entry) => (
              <TextCard title={entry.data.title} href={`/journal/${slugFromId(entry.id)}/`} cta="Read more →">
                {entry.data.description}
              </TextCard>
            ))}
          </CardGrid>
        </Section>
      )
    )
  }

  <Section label="Follow Along" heading="New posts, shared on Instagram too.">
    <p>
      Every new Journal post gets shared on Instagram when it's published — follow along there for
      a heads-up the moment a new plant profile or farm note goes live.
    </p>
    <div class="contact-list">
      <a href="https://www.instagram.com/wildonthefarm">@wildonthefarm on Instagram →</a>
    </div>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Stay Close To The Farm</div>
    <h2>New notes, every Wednesday.</h2>
    <p>From native plants to trail conditions — a running record of this small mountain.</p>
    <div class="contact-list">
      <a href="/the-farm/">The Farm →</a>
      <a href="/birdwatching/">Birdwatching →</a>
    </div>
  </Fragment>
</PageLayout>
