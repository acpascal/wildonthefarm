---
import { getImage, Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import Section from '../../components/Section.astro';
import Split from '../../components/Split.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import NoteBox from '../../components/NoteBox.astro';
import HikeBooking from '../../components/HikeBooking.astro';
import { amistadWildCrossing, cloudForestWaterfall, farmTourCloudForest, type HikeOption } from '../../data/guidedHikes';
import { business } from '../../data/business';
import { img } from '../../lib/images';
import type { PhotoItem } from '../../lib/photos';

const heroImage = img('hiking/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const amenities = [
  'ガイド付き、または自由散策',
  'アミスタッド国立公園への直接アクセス',
  '原生の雲霧林',
  '道中で出会うサルと野鳥',
  '丈夫な登山靴を推奨',
];

const amistadFacts = ["経験者向け", "約11 km", "標高差 850 m", "出発:ピアニスタ(1,268 m)", "最高地点:1,918 m", "到着:Wild on the Farm(1,730 m)", "ガイド必須", "2〜6名", "グルメピクニック付き", "ボケテへは車で戻ります", "傷害保険への加入必須"];

const waterfallFacts = ["中級", "約6.5 km", "標高差 400 m", "出発:カミノ・デル・エスパニョール", "最高地点:1,918 m", "急な斜面", "2〜6名", "月曜・木曜", "グルメピクニック付き"];

const farmTourFacts = ["どなたでも", "約4時間", "標高差 200 m", "出発:農園の下(1,700 m)", "最高地点:1,918 m", "急な斜面", "2〜6名", "金曜", "食事はオプション"];

// The booking form's three hikes, in the order of the sections above it.
const hikeOptions: HikeOption[] = [
  { hike: amistadWildCrossing, title: 'Amistad Wild Crossing', level: "経験者向け", details: ["11 km · 標高差 850 m", "日曜・水曜 午前8時", "エル・ピアニスタ発 · グルメピクニック付き"] },
  { hike: cloudForestWaterfall, title: 'Cloud Forest and Waterfall', level: "中級", details: ["6.5 km · 標高差 400 m", "月曜・木曜 午前9時", "カミノ・デル・エスパニョール発 · グルメピクニック付き"] },
  { hike: farmTourCloudForest, title: 'Farm Tour and Cloud Forest', level: "どなたでも", details: ["約4時間 · 標高差 200 m", "金曜 午前9時", "農園の下から出発 · 食事はオプション"] },
];

const amistadMaps = [
  { image: img('hiking/amistad-wild-crossing-map.webp'), alt: "ピアニスタから Wild on the Farm までの Amistad Wild Crossing のルート地図" },
  { image: img('hiking/amistad-wild-crossing-relief.webp'), alt: "森を抜ける Amistad Wild Crossing のルートの立体図" },
];

const waterfallMaps = [{ image: img('hiking/cloud-forest-waterfall-map.webp'), alt: "カミノ・デル・エスパニョールから Wild on the Farm の上の尾根へ向かう Cloud Forest and Waterfall の周回ルート地図" }];

const farmTourMaps = [
  { image: img('hiking/farm-tour-cloud-forest-relief.webp'), alt: "農園の上を巡る Farm Tour and Cloud Forest の周回ルートの立体図" },
  { image: img('hiking/farm-tour-cloud-forest-above.webp'), alt: "上空から見た Farm Tour and Cloud Forest の周回ルート、農園から雲霧林まで" },
];

const trailPhotos: PhotoItem[] = [
  { image: img('hiking/video-poster-ja.jpg'), alt: '動画：Wild on the Farmから出発する4時間のハイキング', size: 'tall', video: '/videos/hike-4h-ja.mp4' },
  { image: img('hiking/gallery_24.jpg'), alt: 'シダと苔に縁取られ、滝つぼへと流れ落ちる滝', size: 'lg' },
  { image: img('hiking/gallery_03.jpg'), alt: '密生した雲霧林を抜ける、細い小道', size: 'tall' },
  { image: img('hiking/gallery_01.jpg'), alt: '雲霧林へと入っていく小道', size: 'lg' },
  { image: img('hiking/gallery_32.jpg'), alt: '山道で見つけた野生のアンズタケの香りを確かめる', size: 'tall' },
  { image: img('hiking/gallery_36.jpg'), alt: '霧のなか、苔むした巨木のあいだに立つガイド', size: 'lg' },
  { image: img('hiking/gallery_47.jpg'), alt: '森の急な道を下っていく家族', size: 'tall' },
  { image: img('hiking/gallery_02.jpg'), alt: '小道沿いに並ぶ、苔に覆われた木々' },
  { image: img('hiking/gallery_07.jpg'), alt: 'ハイキングコースの、霧に包まれた一区間', size: 'lg' },
  { image: img('hiking/gallery_39.jpg'), alt: '雲霧林の下層に広がる、つややかな巨大な葉' },
  { image: img('hiking/gallery_43.jpg'), alt: '霧の森で先頭を行く農園の犬', size: 'lg' },
  { image: img('hiking/gallery_05.jpg'), alt: '小道から望む、雲霧林の林冠の眺め', size: 'wide' },
  { image: img('hiking/gallery_09.jpg'), alt: '森の中を縫うように続く小道', size: 'tall' },
  { image: img('hiking/gallery_51.jpg'), alt: '倒木の上から、森に覆われた尾根を見わたすハイカー', size: 'tall' },
  { image: img('hiking/gallery_37.jpg'), alt: '苔むした幹のそばを登るハイカー' },
  { image: img('hiking/gallery_04.jpg'), alt: '小道の脇に広がる、シダと下草' },
  { image: img('hiking/gallery_12.jpg'), alt: '小道から見渡す、森の広い眺め', size: 'wide' },
  { image: img('hiking/gallery_41.jpg'), alt: '杖を手に先を歩くガイドと、すぐ後ろをついていく犬' },
  { image: img('hiking/gallery_06.jpg'), alt: '雲霧林に差し込む陽の光' },
  { image: img('hiking/gallery_14.jpg'), alt: '森の林冠の下を通る小道', size: 'lg' },
  { image: img('hiking/gallery_46.jpg'), alt: '雲霧林の二本の巨木のあいだに立つハイカー', size: 'lg' },
  { image: img('hiking/gallery_15.jpg'), alt: 'ハイキングコースの、急な一区間' },
  { image: img('hiking/gallery_16.jpg'), alt: '小道沿いに立つヘゴの木々', size: 'tall' },
  { image: img('hiking/gallery_11.jpg'), alt: '雲霧林の小道、静かな一区間' },
  { image: img('hiking/gallery_49.jpg'), alt: '霧のなかの巨大な幹と、垂れ下がるつる', size: 'wide' },
  { image: img('hiking/gallery_44.jpg'), alt: '木生シダのなかでほほえむガイド' },
  { image: img('hiking/gallery_17.jpg'), alt: '小道にある、渓流の渡り場' },
  { image: img('wildlife/mantled_howler_monkey.jpg'), alt: '小道沿いで見かけた、マントホエザル' },
  { image: img('hiking/gallery_18.jpg'), alt: '小道から見渡す、チリキ高地の眺め', size: 'wide' },
  { image: img('hiking/gallery_40.jpg'), alt: 'シダのあいだの急斜面を登るハイカー', size: 'tall' },
  { image: img('hiking/gallery_50.jpg'), alt: '濃い霧のなか、高い木々のあいだで小さく見えるハイカー', size: 'lg' },
  { image: img('hiking/gallery_19.jpg'), alt: '小道脇に広がる、密生した下層植生' },
  { image: img('hiking/gallery_08.jpg'), alt: '小道脇の木に着生するブロメリア' },
  { image: img('hiking/gallery_21.jpg'), alt: '小道脇にある、苔むした木の幹', size: 'tall' },
  { image: img('hiking/gallery_22.jpg'), alt: '雲霧林の奥へと分け入っていく小道', size: 'lg' },
  { image: img('hiking/gallery_13.jpg'), alt: '小道脇の枝に見られる、苔と着生植物' },
  { image: img('hiking/gallery_23.jpg'), alt: '雲霧林の奥で滝と向き合うハイカー', size: 'tall' },
  { image: img('hiking/gallery_48.jpg'), alt: 'いちばん小さな子を背負って、笑いながら下る家族', size: 'tall' },
  { image: img('hiking/gallery_20.jpg'), alt: '霧の中へと消えていく小道' },
  { image: img('hiking/gallery_30.jpg'), alt: '苔むした倒木に生える、フリルのようなオレンジ色のキノコ', size: 'tall' },
  { image: img('hiking/gallery_25.jpg'), alt: '森に覆われた尾根を見渡す展望地で足を止めるハイカーたち', size: 'wide' },
  { image: img('hiking/gallery_38.jpg'), alt: '濡れた深い下草をかき分けて登るハイカー' },
  { image: img('hiking/gallery_27.jpg'), alt: 'そびえる木々と垂れ下がるツルのなかを歩くハイカーたち', size: 'tall' },
  { image: img('hiking/gallery_42.jpg'), alt: '苔むした倒木を乗り越えるハイカー' },
  { image: img('hiking/gallery_10.jpg'), alt: '小道を横切る木の根' },
  { image: img('hiking/gallery_33.jpg'), alt: '雲霧林の林床に咲く、濃いピンクの花', size: 'tall' },
  { image: img('hiking/gallery_29.jpg'), alt: '木の根が張り出したぬかるみの道をよじ登るハイカー' },
  { image: img('hiking/gallery_31.jpg'), alt: '赤いリュックを背負い、シダと垂れ下がる苔のあいだを進むハイカー' },
  { image: img('hiking/gallery_28.jpg'), alt: '苔むした雲霧林の木々の下、急な山道を登るハイカーたち', size: 'tall' },
  { image: img('hiking/gallery_45.jpg'), alt: '雲霧林の樹冠に向かって両腕を上げて' },
  { image: img('hiking/gallery_52.jpg'), alt: '木生シダのなか、小さな子を背負って歩く家族' },
  { image: img('hiking/gallery_35.jpg'), alt: '山道沿いの草むらに群生する白い野生のキノコ', size: 'wide' },
  { image: img('hiking/gallery_34.jpg'), alt: '山道をふさぐ倒木の下をくぐり抜けるハイカー', size: 'tall' },
];
---

<PageLayout
  title="パナマ・ボケテのガイド付きハイキング | Wild on the Farm, Boquete Cloud Forest Lodge"
  description="ボケテのガイド付きハイキングは50ドルから。雲霧林、滝、ラ・アミスタッド国立公園を横断するルート。2〜6名の少人数制、オンラインで予約できます。"
  path="/ja/hiking/"
  image={ogImage.src}
  pullIntro="人混みから遠く離れた、ボケテの雲霧林でのハイキング。シャトルバスも、登山口の駐車場もありません——あるのは一つの門、そしてその先に広がる、苔と霧、目覚めていく森の音だけです。"
  locale="ja"
>
  <Fragment slot="hero">
    <PhotoHero image={heroImage} alt="Wild on the Farmで雲霧林をハイキングする" eyebrow="ガイド付きハイキング——ボケテ、ラ・アミスタッド国立公園">
      ボケテのハイキング——雲の中へと消えていく小道。
    </PhotoHero>
  </Fragment>

  <Section label="小道の上で" heading="そこで出会う風景。">
    <Split>
      <div>
        <p>
          小道は、原生の雲霧林の中を登っていきます——苔に包まれた幹、ブロメリア、ヘゴの木々。ここに満ちる
          静けさは、遠くの鳴き声も、林冠のかすかな葉擦れの音も、聞き逃すことを許しません。ノドジロオマキ
          ザルとマントホエザルが同じ縄張りを行き来しており、しばしば頭上の真上で見かけることができます。
        </p>
      </div>
      <div>
        <div class="amenity-list">
          {amenities.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </Split>
    <p><a href="/ja/journal/hiking-in-boquete/"><strong>ボケテの小道、その歴史、そして私たち自身が描いた地図 →</strong></a></p>
  </Section>

  <Section label="経験者向け" heading="Amistad Wild Crossing：11kmのガイド付きハイキング">
    <Split>
      <div>
        <p>
          私たちのいちばん本格的なルートです。ピアニスタの谷から Wild on the Farm まで、山とジャングルの地形を約11キロ、ラ・アミスタッド国立公園の険しく手つかずの一帯を横断します。道ははっきりとは見えず、倒木を越え、川を渡り、標高差は850メートルあります。
        </p>
        <p>
          森はとても美しく、終盤の風の吹きつける尾根まで、刻々と表情を変えます。バク、ペッカリー、サル、シカ、オセロット、ピューマ、ジャガー、そしてケツァールが暮らす土地です。
        </p>
        <p>
          <strong>持ち物:</strong>しっかりした登山靴またはブーツ、フリース、雨具とウインドブレーカー、小さく軽いリュック、そして最低1リットルの水。グルメピクニックが付いています。
        </p>
      </div>
      <div>
        <div class="amenity-list">
          {amistadFacts.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </Split>
    <NoteBox>
      <p>
        ルートは決まった道ではないため、必ずガイドと一緒に、最大6名のグループで歩きます。ボケテへは Wild on the Farm から車で戻ります。
      </p>
      <p>
        出発前に免責同意書に署名していただきます。参加者は全員、ハイキング中の事故を補償する保険に加入している必要があります。
      </p>
    </NoteBox>
    <a class="btn btn-normal btn-spaced" href={`?randonnee=${amistadWildCrossing.slug}#reserver`}>このトレイルを予約する</a>
    {amistadMaps.map((map) => (
      <div class="wide-photo">
        <Image src={map.image} alt={map.alt} widths={[480, 900, 1600, 2000]} sizes="100vw" />
      </div>
    ))}
  </Section>

  <Section label="中級" heading="Cloud Forest and Waterfall：6.5kmのガイド付きハイキング">
    <Split>
      <div>
        <p>
          カミノ・デル・エスパニョールを出発し、山の地形を歩く6.5キロの周回コースです。雲霧林、滝、そして美しい尾根。斜面は急で、標高1,918メートルまで400メートルを登ります。
        </p>
        <p>
          <strong>持ち物:</strong>しっかりした登山靴またはブーツ、フリース、雨具とウインドブレーカー、小さく軽いリュック、そして最低1リットルの水。グルメピクニックが付いています。
        </p>
      </div>
      <div>
        <div class="amenity-list">
          {waterfallFacts.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </Split>
    <a class="btn btn-normal btn-spaced" href={`?randonnee=${cloudForestWaterfall.slug}#reserver`}>このトレイルを予約する</a>
    {waterfallMaps.map((map) => (
      <div class="wide-photo">
        <Image src={map.image} alt={map.alt} widths={[480, 900, 1600, 2000]} sizes="100vw" />
      </div>
    ))}
  </Section>

  <Section label="どなたでも" heading="Farm Tour and Cloud Forest：約4時間のガイド付きハイキング">
    <Split>
      <div>
        <p>
          農園の下から出発する約4時間の周回コースです。とても美しい雲霧林へ登り、そのあと Wild on the Farm を巡ります。斜面は急で、標高差は200メートル(1,700〜1,918メートル)です。
        </p>
        <p>
          農園では、マカダミアの農園、動物たち、そしてパーマカルチャーの入門をご案内します。食事は別料金で追加できます。
        </p>
      </div>
      <div>
        <div class="amenity-list">
          {farmTourFacts.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </Split>
    <a class="btn btn-normal btn-spaced" href={`?randonnee=${farmTourCloudForest.slug}#reserver`}>このトレイルを予約する</a>
    {farmTourMaps.map((map) => (
      <div class="wide-photo">
        <Image src={map.image} alt={map.alt} widths={[480, 900, 1600, 2000]} sizes="100vw" />
      </div>
    ))}
  </Section>

  <Section label="予約" heading="ボケテのガイド付きハイキングを予約する。" id="reserver">
    <p>
      ハイキング、月、日の3ステップです。そのあと参加者はそれぞれご自身で予約をお送りください。この時点でのお支払いはありません。ご予約を受け取り次第、デポジットの支払いリンクをメールでお送りします。
    </p>
    <NoteBox>
      <p>
        お支払い:ご予約後、50%のデポジット用の PayPal リンクをメールでお送りします。残りの50%はハイキングの出発前にお支払いください。キャンセル:出発の{amistadWildCrossing.noRefundDays}日前を過ぎると返金はありません。{amistadWildCrossing.minPeople}名以上のお申し込みで催行します。
      </p>
      <p>
        参加者はそれぞれご自身のフォームに記入し、ご自身のデポジットをお支払いください。ハイキングの出発時に、参加者全員がご自身のフォームと免責同意書に署名します。
      </p>
      <p>
        極端な悪天候でツアーを中止する場合は、全額返金、または次の出発日への振替となります。
      </p>
      <p>
        すでに{amistadWildCrossing.maxPeople}名のグループですか?別の日を設けることもできます。{' '}
        <a href={business.whatsappHref}>WhatsApp({business.phone})</a>または{' '}
        <a href={`mailto:${business.email}`}>{business.email}</a> までご連絡ください。
      </p>
    </NoteBox>
    <HikeBooking options={hikeOptions} locale="ja" />
  </Section>

  <Section label="現地にて" heading="この森と出会う、いちばんの方法は、歩くこと。">
    <PhotoGrid items={trailPhotos} groupId="hiking" variant="varied" />
  </Section>

  <Fragment slot="footer">
    <div class="section-label">組み合わせるなら</div>
    <h2>早朝は、鳥たちのもの。</h2>
    <p>多くのお客様が、夜明けの野鳥観察を、その日の後半に行う長めのハイキングと組み合わせています。</p>
    <div class="contact-list">
      <a href="/ja/birdwatching/">野鳥観察 →</a>
      <a href="/ja/farm/">農園に戻る →</a>
    </div>
  </Fragment>
</PageLayout>
