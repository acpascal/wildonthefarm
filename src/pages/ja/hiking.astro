---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import Section from '../../components/Section.astro';
import Split from '../../components/Split.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { img } from '../../lib/images';
import type { PhotoItem } from '../../lib/photos';

const heroImage = img('hiking/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const amenities = [
  'ガイド付き、または自由散策',
  'アミスタッド国立公園への直接アクセス',
  '原生の雲霧林',
  '道中で出会うサルと野鳥',
  '丈夫な登山靴を推奨',
];

const trailPhotos: PhotoItem[] = [
  { image: img('hiking/video-poster-ja.jpg'), alt: '動画：Wild on the Farmから出発する4時間のハイキング', size: 'tall', video: '/videos/hike-4h-ja.mp4' },
  { image: img('hiking/gallery_24.jpg'), alt: 'シダと苔に縁取られ、滝つぼへと流れ落ちる滝', size: 'lg' },
  { image: img('hiking/gallery_03.jpg'), alt: '密生した雲霧林を抜ける、細い小道', size: 'tall' },
  { image: img('hiking/gallery_01.jpg'), alt: '雲霧林へと入っていく小道', size: 'lg' },
  { image: img('hiking/gallery_32.jpg'), alt: '山道で見つけた野生のアンズタケの香りを確かめる', size: 'tall' },
  { image: img('hiking/gallery_36.jpg'), alt: '霧のなか、苔むした巨木のあいだに立つガイド', size: 'lg' },
  { image: img('hiking/gallery_47.jpg'), alt: '森の急な道を下っていく家族', size: 'tall' },
  { image: img('hiking/gallery_02.jpg'), alt: '小道沿いに並ぶ、苔に覆われた木々' },
  { image: img('hiking/gallery_07.jpg'), alt: 'ハイキングコースの、霧に包まれた一区間', size: 'lg' },
  { image: img('hiking/gallery_39.jpg'), alt: '雲霧林の下層に広がる、つややかな巨大な葉' },
  { image: img('hiking/gallery_43.jpg'), alt: '霧の森で先頭を行く農園の犬', size: 'lg' },
  { image: img('hiking/gallery_05.jpg'), alt: '小道から望む、雲霧林の林冠の眺め', size: 'wide' },
  { image: img('hiking/gallery_09.jpg'), alt: '森の中を縫うように続く小道', size: 'tall' },
  { image: img('hiking/gallery_51.jpg'), alt: '倒木の上から、森に覆われた尾根を見わたすハイカー', size: 'tall' },
  { image: img('hiking/gallery_37.jpg'), alt: '苔むした幹のそばを登るハイカー' },
  { image: img('hiking/gallery_04.jpg'), alt: '小道の脇に広がる、シダと下草' },
  { image: img('hiking/gallery_12.jpg'), alt: '小道から見渡す、森の広い眺め', size: 'wide' },
  { image: img('hiking/gallery_41.jpg'), alt: '杖を手に先を歩くガイドと、すぐ後ろをついていく犬' },
  { image: img('hiking/gallery_06.jpg'), alt: '雲霧林に差し込む陽の光' },
  { image: img('hiking/gallery_14.jpg'), alt: '森の林冠の下を通る小道', size: 'lg' },
  { image: img('hiking/gallery_46.jpg'), alt: '雲霧林の二本の巨木のあいだに立つハイカー', size: 'lg' },
  { image: img('hiking/gallery_15.jpg'), alt: 'ハイキングコースの、急な一区間' },
  { image: img('hiking/gallery_16.jpg'), alt: '小道沿いに立つヘゴの木々', size: 'tall' },
  { image: img('hiking/gallery_11.jpg'), alt: '雲霧林の小道、静かな一区間' },
  { image: img('hiking/gallery_49.jpg'), alt: '霧のなかの巨大な幹と、垂れ下がるつる', size: 'wide' },
  { image: img('hiking/gallery_44.jpg'), alt: '木生シダのなかでほほえむガイド' },
  { image: img('hiking/gallery_17.jpg'), alt: '小道にある、渓流の渡り場' },
  { image: img('wildlife/mantled_howler_monkey.jpg'), alt: '小道沿いで見かけた、マントホエザル' },
  { image: img('hiking/gallery_18.jpg'), alt: '小道から見渡す、チリキ高地の眺め', size: 'wide' },
  { image: img('hiking/gallery_40.jpg'), alt: 'シダのあいだの急斜面を登るハイカー', size: 'tall' },
  { image: img('hiking/gallery_50.jpg'), alt: '濃い霧のなか、高い木々のあいだで小さく見えるハイカー', size: 'lg' },
  { image: img('hiking/gallery_19.jpg'), alt: '小道脇に広がる、密生した下層植生' },
  { image: img('hiking/gallery_08.jpg'), alt: '小道脇の木に着生するブロメリア' },
  { image: img('hiking/gallery_21.jpg'), alt: '小道脇にある、苔むした木の幹', size: 'tall' },
  { image: img('hiking/gallery_22.jpg'), alt: '雲霧林の奥へと分け入っていく小道', size: 'lg' },
  { image: img('hiking/gallery_13.jpg'), alt: '小道脇の枝に見られる、苔と着生植物' },
  { image: img('hiking/gallery_23.jpg'), alt: '雲霧林の奥で滝と向き合うハイカー', size: 'tall' },
  { image: img('hiking/gallery_48.jpg'), alt: 'いちばん小さな子を背負って、笑いながら下る家族', size: 'tall' },
  { image: img('hiking/gallery_20.jpg'), alt: '霧の中へと消えていく小道' },
  { image: img('hiking/gallery_30.jpg'), alt: '苔むした倒木に生える、フリルのようなオレンジ色のキノコ', size: 'tall' },
  { image: img('hiking/gallery_25.jpg'), alt: '森に覆われた尾根を見渡す展望地で足を止めるハイカーたち', size: 'wide' },
  { image: img('hiking/gallery_38.jpg'), alt: '濡れた深い下草をかき分けて登るハイカー' },
  { image: img('hiking/gallery_27.jpg'), alt: 'そびえる木々と垂れ下がるツルのなかを歩くハイカーたち', size: 'tall' },
  { image: img('hiking/gallery_42.jpg'), alt: '苔むした倒木を乗り越えるハイカー' },
  { image: img('hiking/gallery_10.jpg'), alt: '小道を横切る木の根' },
  { image: img('hiking/gallery_33.jpg'), alt: '雲霧林の林床に咲く、濃いピンクの花', size: 'tall' },
  { image: img('hiking/gallery_29.jpg'), alt: '木の根が張り出したぬかるみの道をよじ登るハイカー' },
  { image: img('hiking/gallery_31.jpg'), alt: '赤いリュックを背負い、シダと垂れ下がる苔のあいだを進むハイカー' },
  { image: img('hiking/gallery_28.jpg'), alt: '苔むした雲霧林の木々の下、急な山道を登るハイカーたち', size: 'tall' },
  { image: img('hiking/gallery_45.jpg'), alt: '雲霧林の樹冠に向かって両腕を上げて' },
  { image: img('hiking/gallery_52.jpg'), alt: '木生シダのなか、小さな子を背負って歩く家族' },
  { image: img('hiking/gallery_35.jpg'), alt: '山道沿いの草むらに群生する白い野生のキノコ', size: 'wide' },
  { image: img('hiking/gallery_34.jpg'), alt: '山道をふさぐ倒木の下をくぐり抜けるハイカー', size: 'tall' },
];
---

<PageLayout
  title="雲霧林をハイキングする | Wild on the Farm, Boquete Cloud Forest Lodge"
  description="農園の入り口から続く、アミスタッド国立公園へと至る小道——苔に覆われた雲霧林、サルたち、そしてチリキ高地を望む眺め。"
  path="/ja/hiking/"
  image={ogImage.src}
  pullIntro="人混みから遠く離れた、ボケテの雲霧林でのハイキング。シャトルバスも、登山口の駐車場もありません——あるのは一つの門、そしてその先に広がる、苔と霧、目覚めていく森の音だけです。"
  locale="ja"
>
  <Fragment slot="hero">
    <PhotoHero image={heroImage} alt="Wild on the Farmで雲霧林をハイキングする" eyebrow="アミスタッド国立公園ハイキング——人混みから遠く離れて">
      私たちの扉から始まり、雲の中へと消えていく小道。
    </PhotoHero>
  </Fragment>

  <Section label="小道の上で" heading="そこで出会う風景。">
    <Split>
      <div>
        <p>
          小道は、原生の雲霧林の中を登っていきます——苔に包まれた幹、ブロメリア、ヘゴの木々。ここに満ちる
          静けさは、遠くの鳴き声も、林冠のかすかな葉擦れの音も、聞き逃すことを許しません。ノドジロオマキ
          ザルとマントホエザルが同じ縄張りを行き来しており、しばしば頭上の真上で見かけることができます。
        </p>
      </div>
      <div>
        <div class="amenity-list">
          {amenities.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </Split>
    <p><a href="/ja/journal/hiking-in-boquete/"><strong>ボケテの小道、その歴史、そして私たち自身が描いた地図 →</strong></a></p>
  </Section>

  <Section label="現地にて" heading="この森と出会う、いちばんの方法は、歩くこと。">
    <PhotoGrid items={trailPhotos} groupId="hiking" variant="varied" />
  </Section>

  <Fragment slot="footer">
    <div class="section-label">組み合わせるなら</div>
    <h2>早朝は、鳥たちのもの。</h2>
    <p>多くのお客様が、夜明けの野鳥観察を、その日の後半に行う長めのハイキングと組み合わせています。</p>
    <div class="contact-list">
      <a href="/ja/birdwatching/">野鳥観察 →</a>
      <a href="/ja/farm/">農園に戻る →</a>
    </div>
  </Fragment>
</PageLayout>
