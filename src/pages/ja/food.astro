---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { img } from '../../lib/images';

const heroImage = img('kitchen/dining_room.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const diningPhotos = [
  { image: img('kitchen/dining_room.jpg'), alt: '食事の準備が整った、Wild on the Farmのダイニングルーム' },
  { image: img('kitchen/dining_room_detail.jpg'), alt: 'ダイニングルームの木製家具のディテール' },
];

const kitchenPhotos = [
  { image: img('kitchen/kitchen_wide.jpg'), alt: '農園の厨房を広く見渡す' },
  { image: img('kitchen/cook_at_work.jpg'), alt: '農園の厨房で料理を仕込む料理人' },
];

const tablePhotos = [
  { image: img('kitchen/table_guests_1.jpg'), alt: '共用の食卓で食事を分かち合うお客様たち' },
  { image: img('kitchen/table_guests_2.jpg'), alt: '共用の食卓に共に座るお客様たち' },
];

const foodPhotos = [
  { image: img('food/chicken_stew.jpg'), alt: '農園で育った野菜で作るチキンシチュー' },
  { image: img('food/roasted_tomatoes.jpg'), alt: '菜園のトマトのロースト' },
  { image: img('food/plated_dish.jpg'), alt: 'Wild on the Farmで供される一皿' },
  { image: img('food/four_salads.jpg'), alt: '菜園の恵みで作る、四種の季節のサラダ' },
  { image: img('food/salad_with_view.jpg'), alt: '雲霧林を望みながら味わう、摘みたてのサラダ' },
];
---

<PageLayout
  title="お料理 | Wild on the Farm, Boquete Cloud Forest Lodge"
  description="パナマ、ボケテのWild on the Farmにある、実際に稼働する農園の厨房——段々畑の菜園で育つオーガニックの恵みを、シンプルに調理し、ひとつの長い食卓で分かち合う。"
  path="/ja/food/"
  image={ogImage.src}
  pullIntro="
    ひとつの長い食卓を囲み、言葉と文化を溶け合わせて、かけがえのない人と人とのひとときを紡ぐ——それこそが、私たちの山が贈る、いちばん美しい贈り物です。パチャパパのキッチンへ、ようこそ。
    ここでは火がぱちぱちとはぜ、味わいは、おいしさと健やかさと多様さのあいだで、美しく響き合います。野草は特等席に。繊細で、静かな力を秘めた存在です。
    毎日が、まっさらな新しいページ。私の料理は自由です。菜園の実りのリズム、その日の空模様、そして朝のひらめきに合わせて、かたちを変えていきます。
  "
  locale="ja"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Wild on the Farmのダイニングルーム" eyebrow="お料理">
      パチャパパの料理。
    </PageHero>
  </Fragment>

  <Section label="ダイニングルーム">
    <p class="display">
      パチャパパの家へ、ようこそ。
    </p>
    <PhotoGrid items={diningPhotos} groupId="kitchen-dining" />
  </Section>

  <Section label="厨房">
    <p class="display">
      味の魔法使いが、農園の恵みを自在に踊らせる場所。
    </p>
    <PhotoGrid items={kitchenPhotos} groupId="kitchen-kitchen" />
  </Section>

  <Section label="食卓を囲んで">
    <p class="display">
      私たちの食卓では、国境はそっと溶けてゆき、分かち合う味わいと、食べるよろこび、そして世界がひとつになる出会いの魔法が広がります。
    </p>
    <PhotoGrid items={tablePhotos} groupId="kitchen-table" />
  </Section>

  <Section label="私たちの菜園から" heading="オーガニックで、旬を味わう——コンロからほんの数歩。">
    <p class="display">
      最後の鼓動まで脈打ち続けるその心臓は、十八年にわたる試行錯誤と経験を守り続けています。私たちが土を
      養えば、土はその見返りに、命の力を宿した植物を育て、それをあなたのもとへと届けてくれます。それ以外
      の道は、あなたの健康を損なうものでしかありません。
    </p>
    <p><a href="/ja/garden/"><strong>菜園を訪れる →</strong></a></p>
  </Section>

  <Section label="私たちが作るもの">
    <p class="display">
      私たちの料理は、この地をとりまく大地と、ここにしかない気候の味わいを物語ります。惜しみなく分かち合う、あたたかな食卓。その一皿一皿に、この土地の風土が映し出され、私たちをつなぐ絆となります。
    </p>
    <PhotoGrid items={foodPhotos} groupId="kitchen-food" />
  </Section>

  <Fragment slot="footer">
    <div class="section-label">ご滞在の計画を</div>
    <h2>もうお腹が空いてきましたか？</h2>
    <div class="contact-list">
      <a href="/ja/farm/">農園を見る →</a>
      <a href="/ja/lodge/">ロッジを見る →</a>
    </div>
  </Fragment>
</PageLayout>
