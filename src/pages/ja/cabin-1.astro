---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { img } from '../../lib/images';
import { pageHref } from '../../data/pageTranslations';

const heroImage = img('cabin1/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const photos = [
  { image: heroImage, alt: '雲霧林に佇む、コテージ1の外観' },
  { image: img('cabin1/gallery_1.jpg'), alt: 'コテージ1の内部' },
  { image: img('cabin1/gallery_2.jpg'), alt: 'コテージ1のバルコニーからの眺め' },
  { image: img('cabin1/gallery_3.jpg'), alt: '手描きの葉模様タイルを使った、コテージ1のバスルーム' },
];

const amenities = [
  '専用のバスルーム',
  '葉模様タイルのウォークインシャワー',
  '上質な寝具',
  '専用バルコニー',
  '緑の屋根',
  'あえてWi-Fiもテレビも置いていません',
];

const reserveHref = pageHref('reserve', 'ja');
---

<PageLayout
  title="コテージ1 — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Wild on the Farmのコテージ1：霧に包まれた雲霧林にひっそりと佇む専用テラス、葉模様タイルのウォークインシャワー、そして温もりある無垢材の内装。"
  path="/ja/cabin-1/"
  image={ogImage.src}
  pullIntro="樹林限界にもっとも近い場所に建つコテージ1は、雲霧林のもっとも親密な表情をとらえています——竹と霧に包まれた専用バルコニー、そして手描きの葉模様タイルで一面を仕上げたバスルーム。"
  locale="ja"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="雲霧林に佇む、コテージ1の外観" eyebrow="ご滞在——コテージ1">
      霧の、いちばん奥へ。
    </PageHero>
  </Fragment>

  <Section label="隅々まで" heading="コテージ1のすべて。">
    <PhotoGrid items={photos} groupId="cabin-1" />
  </Section>

  <Section>
    <div class="amenity-list">
      {amenities.map((item) => <span>{item}</span>)}
    </div>
    <a href={reserveHref} class="btn btn-normal btn-spaced">コテージ1を予約する</a>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">見比べる</div>
    <h2>他のコテージも見る。</h2>
    <div class="contact-list">
      <a href="/ja/lodge/">すべてのコテージ →</a>
      <a href="/ja/cabin-2/">コテージ2 →</a>
      <a href="/ja/cabin-3/">コテージ3 →</a>
    </div>
  </Fragment>
</PageLayout>
