---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import JournalSectionPage from '../../../components/JournalSectionPage.astro';
import { JOURNAL_SECTION_KEYS, journalSections, journalUi, type JournalSectionKey } from '../../../data/journalSections';
import { slugFromId, localeFromId, getJournalTranslations, type JournalEntry } from '../../../lib/journal';

export async function getStaticPaths() {
  const entries = await getCollection('journal', (entry) => localeFromId(entry.id) === 'ja' && !entry.data.draft);
  // Each journal section also gets a page here, at its own slug — see
  // data/journalSections.ts. An article can't share a section's slug.
  const sectionPaths = JOURNAL_SECTION_KEYS.map((section) => ({
    params: { slug: journalSections[section].slug['ja'] },
    props: { section },
  }));
  const articlePaths = entries.map((entry) => ({
    params: { slug: slugFromId(entry.id) },
    props: { entry },
  }));
  return [...sectionPaths, ...articlePaths];
}

interface Props {
  entry?: JournalEntry;
  section?: JournalSectionKey;
}

const { entry, section } = Astro.props;

// Everything below is article-only — left undefined on a section page.
const article = entry && {
  Content: (await render(entry)).Content,
  slug: slugFromId(entry.id),
  alternates: await getJournalTranslations(entry),
  // A plant profile says so; anything else carries its section's name.
  eyebrow:
    entry.data.kind === 'plant' ? journalUi['ja'].plantProfile : journalSections[entry.data.section].copy['ja'].label,
  // timeZone: 'UTC' matters here — frontmatter dates like `2026-02-02` parse
  // as UTC midnight, and without pinning the formatter to UTC too, a
  // negative-offset timezone (e.g. Panama, UTC-5) renders it as the day
  // before.
  dateDisplay: entry.data.date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }),
};
---

{section && <JournalSectionPage section={section} locale="ja" />}

{
  entry && article && (
    <ArticleLayout
      title={entry.data.title}
      description={entry.data.description}
      path={`/ja/journal/${article.slug}/`}
      cover={entry.data.cover!}
      coverAlt={entry.data.coverAlt ?? entry.data.title}
      eyebrow={article.eyebrow}
      date={entry.data.date}
      dateDisplay={article.dateDisplay}
      pullIntro={entry.data.pullIntro}
      section={entry.data.section}
      locale="ja"
      alternates={article.alternates}
    >
      <article.Content />
    </ArticleLayout>
  )
}
