---
import { getImage } from 'astro:assets';
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Section from '../../../components/Section.astro';
import CardGrid from '../../../components/CardGrid.astro';
import TextCard from '../../../components/TextCard.astro';
import { img } from '../../../lib/images';
import { getJournal, groupBySection, slugFromId } from '../../../lib/journal';

const heroImage = img('farm/overview_1.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const entries = await getJournal('ja');
const sections = groupBySection(entries);

const sectionCopy = {
  'what-we-grow': {
    label: '育てているもの',
    heading: '私たちが育てているもの、そしてその効能。',
    intro:
      '薬用・療法的な効能、料理としての魅力、そして自分で育てる方法まで——この農園から生まれるものの背景にある、より大きな物語とともにお届けする植物図鑑です。',
  },
  'farm-notes': {
    label: 'ボケテガイド',
    heading: '山の歴史と暮らし。',
    intro: '旅行ガイド、地域の歴史、小道の状況、気功とウェルネス、そして農園から分かち合う価値のあるあらゆること。',
  },
  'travel-panama': {
    label: 'パナマを旅する',
    heading: 'ボケテの先にある、物語とガイド。',
    intro: 'この国全体からの体験談と旅の記録——農園だけでなく、野生に満ちたパナマのその他の土地についても。',
  },
};
---

<PageLayout
  title="日誌 — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Wild on the Farm、Boquete Cloud Forest Lodgeからの記事——植物図鑑、農園の暮らし、ハイキングと野生生物、ウェルネス、そしてボケテとパナマ各地への旅行ガイド。"
  path="/ja/journal/"
  image={ogImage.src}
  pullIntro="私たちが育てている植物の図鑑——その薬用・料理としての使い方、そして育て方——に加え、小道の状況や在来種、そしてこの小さな山の健やかさについての季節ごとの便り。"
  locale="ja"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="農園の敷地の全景" eyebrow="日誌">
      農園から、毎週届く便り。
    </PageHero>
  </Fragment>

  {
    sections.map(([key, items], i) =>
      items.length > 0 && (
        <Section label={sectionCopy[key].label} heading={sectionCopy[key].heading}>
          <p>{sectionCopy[key].intro}</p>
          <CardGrid>
            {items.map((entry) => (
              <TextCard title={entry.data.title} href={`/ja/journal/${slugFromId(entry.id)}/`} cta="続きを読む →">
                {entry.data.description}
              </TextCard>
            ))}
          </CardGrid>
        </Section>
      )
    )
  }

  <Section label="フォローする" heading="新しい記事は、Instagramでも。">
    <p>
      日誌の新しい記事は、公開されるたびにInstagramでも共有されます——新しい植物図鑑や農園の便りが公開さ
      れた瞬間にお知らせを受け取りたい方は、ぜひフォローしてください。
    </p>
    <div class="contact-list">
      <a href="https://www.instagram.com/wildonthefarm">Instagramの@wildonthefarm →</a>
    </div>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">農園のそばに</div>
    <h2>毎週水曜日、新しい便りを。</h2>
    <p>在来植物から小道の状況まで——この小さな山についての、絶えず更新される記録。</p>
    <div class="contact-list">
      <a href="/ja/farm/">農園を見る →</a>
      <a href="/ja/birdwatching/">野鳥観察 →</a>
    </div>
  </Fragment>
</PageLayout>
