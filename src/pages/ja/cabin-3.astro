---
import { getImage } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { img } from '../../lib/images';
import { pageHref } from '../../data/pageTranslations';

const heroImage = img('cabin3/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const photos = [
  { image: heroImage, alt: 'コテージ3の内部' },
  { image: img('cabin3/gallery_1.jpg'), alt: 'コテージ3の、手彫りのヘッドボード' },
  { image: img('cabin3/gallery_2.jpg'), alt: '手描きのアール・ヌーヴォー・タイルを施した、コテージ3のバスルーム' },
  { image: img('cabin3/gallery_3.jpg'), alt: 'コテージ3の寝室のディテール' },
  { image: img('cabin3/gallery_4.jpg'), alt: 'コテージ3の内部のディテール' },
  { image: img('cabin3/gallery_5.jpg'), alt: 'コテージ3の、植物模様のリネン' },
];

const amenities = [
  '専用のバスルーム',
  '手描きのアール・ヌーヴォー・タイル',
  '手彫りのヘッドボード',
  '上質な寝具',
  '緑の屋根',
  'あえてWi-Fiもテレビも置いていません',
];

const reserveHref = pageHref('reserve', 'ja');
---

<PageLayout
  title="コテージ3 — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Wild on the Farmのコテージ3：手彫りのヘッドボード、植物模様のファブリック、そして手描きのアール・ヌーヴォー・タイルを施したバスルーム。"
  path="/ja/cabin-3/"
  image={ogImage.src}
  pullIntro="コテージ3は、細部にこだわり抜いた一棟です——手彫りの木製ヘッドボード、植物模様のリネン、そして床から天井まで手描きのアール・ヌーヴォー・タイルで彩られたバスルーム。三棟の中でもっとも装飾的でありながら、その静けさは少しも損なわれていません。"
  locale="ja"
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="コテージ3の内部" eyebrow="ご滞在——コテージ3">
      三棟の中で、もっとも精緻な一棟。
    </PageHero>
  </Fragment>

  <Section label="隅々まで" heading="コテージ3のすべて。">
    <PhotoGrid items={photos} groupId="cabin-3" />
  </Section>

  <Section>
    <div class="amenity-list">
      {amenities.map((item) => <span>{item}</span>)}
    </div>
    <a href={reserveHref} class="btn btn-normal btn-spaced">コテージ3を予約する</a>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">見比べる</div>
    <h2>他のコテージも見る。</h2>
    <div class="contact-list">
      <a href="/ja/lodge/">すべてのコテージ →</a>
      <a href="/ja/cabin-1/">コテージ1 →</a>
      <a href="/ja/cabin-2/">コテージ2 →</a>
    </div>
  </Fragment>
</PageLayout>
