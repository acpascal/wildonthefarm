---
import { getImage, Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import Section from '../../components/Section.astro';
import Split from '../../components/Split.astro';
import Gallery from '../../components/Gallery.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import { img } from '../../lib/images';

const heroImage = img('farm/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const permacultureImage = img('retreats/farm_animals.jpg');

const galleryItems = [
  { image: img('farm/property_overview.jpg'), alt: '雲霧林に広がる農園を空から望む', size: 'lg' as const },
  { image: img('farm/gallery_1.jpg'), alt: 'Wild on the Farmの農園風景' },
  { image: img('farm/gallery_2.jpg'), alt: 'Wild on the Farmの農園風景', size: 'tall' as const },
  { image: img('farm/overview_1.jpg'), alt: '雲霧林に広がる農園の全景', size: 'wide' as const },
  { image: img('farm/gallery_4.jpg'), alt: 'Wild on the Farmの農園風景' },
  { image: img('farm/pergola.jpg'), alt: '農園に佇むパーゴラ' },
];
---

<PageLayout
  title="農園 — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="パナマの雲霧林、標高1,800メートル、アミスタッド国立公園の縁に広がる、十八年にわたるオーガニック・パーマカルチャー農園。"
  path="/ja/farm/"
  image={ogImage.src}
  pullIntro="標高1,800メートル、アミスタッド国立公園の雲霧林に抱かれた私たちの農園は、静けさと、涼やかな山の空気に満ちた安らぎの地です。その静寂は、ほとんど修道院のよう——大自然に抱かれたこの場所は、心身を癒し、生きることの本質に立ち返るひとときへと誘います。"
  locale="ja"
>
  <Fragment slot="hero">
    <PhotoHero image={heroImage} alt="ボケテ、Wild on the Farmの農園" eyebrow="農園">
      最初のお客様が訪れるよりずっと前から、十八年にわたって耕されてきた大地。
    </PhotoHero>
  </Fragment>

  <Section label="写真で見る" heading="私たちよりずっと前から、ここにあった風景。">
    <Gallery items={galleryItems} groupId="the-farm" />
  </Section>

  <Section>
    <Split>
      <div>
        <div class="section-label">2008年より</div>
        <h2 class="lede">宿泊施設になるずっと前から、実際に耕されてきた農園。</h2>
      </div>
      <div>
        <p>
          Wild on the Farmは、農園らしく見せるために作られた場所ではありません。2008年以来、実際にひとつ
          の農園であり続けてきました——周囲の雲霧林と辛抱強く調和しながら育まれてきた、オーガニックのマカ
          ダミア農園です。
        </p>
        <p>
          2025年、手作りの三棟のコテージが、初めて扉を開きました。それ以外のもの——土も、木々も、季節の巡
          りも——は、十八年という歳月をかけて、すでにここに在ったのです。
        </p>
      </div>
    </Split>
  </Section>

  <Section>
    <Split>
      <div>
        <div class="section-label">パーマカルチャーに根ざした暮らし</div>
        <h2 class="lede">山に逆らわず、山とともに。</h2>
        <p>
          農園は完全にオフグリッドで営まれています。電力はソーラーパネルによって賄われ、水はアミスタッド
          国立公園の奥、2キロメートルあまり入った場所で岩盤から直接湧き出る源泉から引かれています。
        </p>
        <p>
          長い年月をかけて、私たちは丘の斜面をレンガ張りの段々畑へと形づくってきました。そこでは野菜、香
          草、そして薬草が、順に巡りながら育っています。小さな羊の群れは、昼のあいだマカダミアや果樹の下
          で草を食み——下草を刈り、土に養分を与えながら——夕方になると、捕食者から身を守るため、それぞれ
          の囲いへと戻っていきます。羊たちと、鶏たちの糞は堆肥にされ、再び大地へと還されます。
        </p>
        <p>
          液体肥料も自家製です——イラクサ、コンフリー、チトニアを発酵させた天然の肥料が、外から何も持ち込
          むことなく段々畑を養っています。同じイラクサは、私たちの厨房にも届けられ、スープとして、また食
          卓で供されるお茶として味わわれます。
        </p>
      </div>
      <div class="split-photo">
        <Image
          src={permacultureImage}
          alt="マカダミアの木の下で共に草を食む羊と鶏"
          widths={[400, 700, 1000]}
          sizes="(min-width: 860px) 50vw, 100vw"
          loading="lazy"
        />
      </div>
    </Split>
  </Section>

  <Section>
    <Split>
      <div>
        <div class="section-label">リトリートを超えて</div>
        <h2 class="lede">まず生きた農園であり、さまざまな旅人のための聖域である。</h2>
      </div>
      <div>
        <p>
          ここにある静けさは、ある特定のお客様のためだけのものではありません。夜明けにバードウォッチャー
          の耳を研ぎ澄ませるのも、山道をより長く、より豊かに感じさせるのも、そして菜園から届いた素朴な一
          皿を、ゆっくりと味わう価値あるものに変えるのも、同じひとつの静寂なのです。
        </p>
      </div>
    </Split>
  </Section>

  <QuoteSection cite="— パスカル、創設者">
    "四十年にわたり、世界の大自然を自らの足で歩き、大陸をまたいで出会った類まれな人々から学び続けた末、パ
    スカルはその知恵を活かす理想の場所を見出しました——この生きた農園を、同じ静けさに惹かれる旅人たちのた
    めの聖域へと変えて。"
  </QuoteSection>

  <Section label="私たちの場所" heading="農園の様子と、これまでのお客様の声をご覧ください。">
    <div class="map-embed">
      <iframe
        title="Wild on the Farmの所在地（Googleマップ）"
        width="100%"
        height="450"
        style="border:0"
        loading="lazy"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3942.6012169702753!2d-82.45058332498353!3d8.823481391229862!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa5edd18b24f369%3A0x11b58604931f7e19!2sWild%20on%20the%20farm!5e0!3m2!1sfr!2spa!4v1787767091890!5m2!1sfr!2spa"
      />
    </div>
    <div class="contact-list">
      <a href="https://www.google.com/maps?cid=1276073423635709465">Googleでの口コミを見る →</a>
    </div>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">さらに巡る</div>
    <h2>農園から、次はどこへ。</h2>
    <p>眠る場所、食卓のために育てられるもの、そして扉を出てすぐに始まる山道——その先をご覧ください。</p>
    <div class="contact-list">
      <a href="/ja/lodge/">コテージを見る →</a>
      <a href="/ja/food/">お料理を見る →</a>
      <a href="/ja/birdwatching/">野鳥観察と山道 →</a>
    </div>
  </Fragment>
</PageLayout>
