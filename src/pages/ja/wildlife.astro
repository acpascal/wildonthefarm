const treesAndOrchids = [
  { name: '高地カシ類', latin: 'Quercus costaricensis & Q. copeyensis', description: '上層の林冠を占める固有種のカシで、なかには50メートルに達するものもあります——この雲霧林を支える骨格そのものであり、その枝は、上に広がる苔や着生植物を支える主要な足場となっています。' },
  { name: '野生アボカド類', latin: 'クスノキ科', description: '小さな野生アボカドの仲間を豊富に含むクスノキ科は、林冠の中層の多くを占めています——そして、それこそが、ケツァールがこの森を選ぶ理由でもあります。野生アボカドの実は、その食事のほとんどすべてを占めているのです。' },
