---
import { getImage } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { img } from '../lib/images';

const heroImage = img('cabin2/hero.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const photos = [
  { image: heroImage, alt: 'Cabin Hummingbird raised on stilts above the valley' },
  { image: img('cabin2/gallery_1.jpg'), alt: 'Interior of Cabin Hummingbird' },
  { image: img('cabin2/gallery_2.jpg'), alt: 'Cabin Hummingbird balcony and valley view' },
  { image: img('cabin2/gallery_3.jpg'), alt: 'Cabin Hummingbird bedroom' },
  { image: img('cabin2/gallery_4.jpg'), alt: 'Cabin Hummingbird bathroom' },
  { image: img('cabin2/gallery_5.jpg'), alt: 'View over the Chiriquí valley from Cabin Hummingbird' },
  { image: img('cabin2/gallery_6.jpg'), alt: 'Cabin Hummingbird exterior detail' },
  { image: img('cabin2/gallery_7.jpg'), alt: 'Cabin Hummingbird deck' },
];

const amenities = [
  'Private ensuite bathroom',
  'Leaf-tiled walk-in shower',
  'High-end bedding',
  'Private balcony',
  'Valley & Volcán Barú view',
  'Raised, stilted structure',
  'No Wi-Fi or TV, by design',
];
---

<PageLayout
  title="Cabin Hummingbird — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Cabin Hummingbird at Wild on the Farm: raised on stilts above the hillside, with sweeping views over the Chiriquí valley from the bed, the balcony, and the shower."
  path="/cabin-2/"
  image={ogImage.src}
  pullIntro="Step into this cabin and a 'Wow!' of wonder is the only fitting response to its atmosphere and one-of-a-kind view. This is the cabin for following the ballet of the clouds and dancing with the stars..."
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Cabin Hummingbird raised on stilts above the valley" eyebrow="Stay — Cabin Hummingbird">
      Suspended between sky and earth.
    </PageHero>
  </Fragment>

  <Section label="Every Corner" heading="All of Cabin Hummingbird.">
    <PhotoGrid items={photos} groupId="cabin-2" />
    <div class="amenity-list centered">
      {amenities.map((item) => <span>{item}</span>)}
    </div>
  </Section>

  <Section label="Book Your Stay">
    <div id="apartmentIframeAll">
      <script is:inline type="text/javascript" src="https://login.smoobu.com/js/Settings/BookingToolIframe.js"></script>
      <script is:inline>
        BookingToolIframe.initialize({
          url: 'https://login.smoobu.com/en/booking-tool/iframe/1880246',
          baseUrl: 'https://login.smoobu.com',
          target: '#apartmentIframeAll',
        });
      </script>
    </div>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Compare</div>
    <h2>See the other cabins.</h2>
    <div class="contact-list">
      <a href="/lodge/">All Cabins →</a>
      <a href="/cabin-1/">Cabin Quetzal →</a>
      <a href="/cabin-3/">Cabin Jaguar →</a>
    </div>
  </Fragment>
</PageLayout>
