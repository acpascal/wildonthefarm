---
import { getImage } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { img } from '../lib/images';
import { pageHref } from '../data/pageTranslations';

const heroImage = img('cabin3/hero_view_3.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const photos = [
  { image: img('cabin3/gallery_3.jpg'), alt: 'Cabin Three bedroom detail' },
  { image: img('cabin3/gallery_4.jpg'), alt: 'Cabin Three interior detail' },
  { image: img('cabin3/gallery_6.jpg'), alt: 'Cabin Three bedroom with wood stove and forest view' },
  { image: img('cabin3/gallery_7.jpg'), alt: 'Cabin Three hand-carved headboard detail' },
  { image: img('cabin3/gallery_8.jpg'), alt: 'Cabin Three wood stove' },
  { image: img('cabin3/gallery_9.jpg'), alt: 'Cabin Three exterior with living roof, seen from the cloud forest above' },
  { image: img('cabin3/gallery_10.jpg'), alt: 'Cabin Three living roof and wooden facade' },
  { image: img('cabin3/gallery_11.jpg'), alt: 'Cabin Three bedroom with carved bed and patterned tile floor' },
];

const amenities = [
  'Private ensuite bathroom',
  'Hand-painted Art Nouveau tile',
  'Hand-carved headboard',
  'High-end bedding',
  'Living roof',
  'No Wi-Fi or TV, by design',
];

const reserveHref = pageHref('reserve', 'en');
---

<PageLayout
  title="Cabin Three — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Cabin Three at Wild on the Farm: a hand-carved headboard, botanical fabrics, and a hand-painted Art Nouveau tiled bathroom."
  path="/cabin-3/"
  image={ogImage.src}
  pullIntro="Cabin Three leans into detail — a hand-carved wooden headboard, botanical linens, and a bathroom dressed floor to ceiling in hand-painted Art Nouveau tile. The most decorative of the three cabins, without losing any of the quiet."
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Cabin Three's hand-carved headboard and botanical linens" eyebrow="Stay — Cabin Three">
      The most intricate of the three.
    </PageHero>
  </Fragment>

  <Section label="Every Corner" heading="All of Cabin Three.">
    <PhotoGrid items={photos} groupId="cabin-3" />
  </Section>

  <Section>
    <div class="amenity-list">
      {amenities.map((item) => <span>{item}</span>)}
    </div>
    <a href={reserveHref} class="btn btn-normal btn-spaced">Reserve Cabin Three</a>
  </Section>

  <Section label="Availability" heading="See what's open.">
    <div id="smoobuApartment3499501en" class="calendarWidget">
      <div
        class="calendarContent"
        data-load-calendar-url="https://login.smoobu.com/en/cockpit/widget/single-calendar/3499501"
        data-verification="cea07d80331e239bb8fe3c4f9f67771c044e2f9edcc4baeee4ed209805b1e0e9"
        data-baseUrl="https://login.smoobu.com"
        data-disable-css="false"
      >
      </div>
      <script is:inline type="text/javascript" src="https://login.smoobu.com/js/Apartment/CalendarWidget.js"></script>
    </div>
    <p>Not available? Try <a href="/cabin-1/">Cabin One</a> or <a href="/cabin-2/">Cabin Two</a>.</p>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Compare</div>
    <h2>See the other cabins.</h2>
    <div class="contact-list">
      <a href="/lodge/">All Cabins →</a>
      <a href="/cabin-1/">Cabin One →</a>
      <a href="/cabin-2/">Cabin Two →</a>
    </div>
  </Fragment>
</PageLayout>
