---
import { getImage } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { img } from '../lib/images';

const heroImage = img('cabin3/hero_view_3.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });

const photos = [
  { image: img('cabin3/gallery_3.jpg'), alt: 'Cabin Jaguar bedroom detail' },
  { image: img('cabin3/gallery_4.jpg'), alt: 'Cabin Jaguar interior detail' },
  { image: img('cabin3/gallery_6.jpg'), alt: 'Cabin Jaguar bedroom with wood stove and forest view' },
  { image: img('cabin3/gallery_7.jpg'), alt: 'Cabin Jaguar hand-carved headboard detail' },
  { image: img('cabin3/gallery_8.jpg'), alt: 'Cabin Jaguar wood stove' },
  { image: img('cabin3/gallery_9.jpg'), alt: 'Cabin Jaguar exterior with living roof, seen from the cloud forest above' },
  { image: img('cabin3/gallery_10.jpg'), alt: 'Cabin Jaguar living roof and wooden facade' },
  { image: img('cabin3/gallery_11.jpg'), alt: 'Cabin Jaguar bedroom with carved bed and patterned tile floor' },
];

const amenities = [
  'Private ensuite bathroom',
  'Hand-painted Art Nouveau tile',
  'Hand-carved headboard',
  'High-end bedding',
  'Living roof',
  'No Wi-Fi or TV, by design',
];
---

<PageLayout
  title="Cabin Jaguar — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="Cabin Jaguar at Wild on the Farm: a hand-carved headboard, botanical fabrics, and a hand-painted Art Nouveau tiled bathroom."
  path="/cabin-3/"
  image={ogImage.src}
  pullIntro="Cabin Jaguar leans into detail — a hand-carved wooden headboard, botanical linens, and a bathroom dressed floor to ceiling in hand-painted Art Nouveau tile. The most decorative of the three cabins, without losing any of the quiet."
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Cabin Jaguar's hand-carved headboard and botanical linens" eyebrow="Stay — Cabin Jaguar">
      The most intricate of the three.
    </PageHero>
  </Fragment>

  <Section label="Every Corner" heading="All of Cabin Jaguar.">
    <PhotoGrid items={photos} groupId="cabin-3" />
    <div class="amenity-list centered">
      {amenities.map((item) => <span>{item}</span>)}
    </div>
  </Section>

  <Section label="Book Your Stay">
    <div id="apartmentIframeAll">
      <script is:inline type="text/javascript" src="https://login.smoobu.com/js/Settings/BookingToolIframe.js"></script>
      <script is:inline>
        BookingToolIframe.initialize({
          url: 'https://login.smoobu.com/en/booking-tool/iframe/1880246',
          baseUrl: 'https://login.smoobu.com',
          target: '#apartmentIframeAll',
        });
      </script>
    </div>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Compare</div>
    <h2>See the other cabins.</h2>
    <div class="contact-list">
      <a href="/lodge/">All Cabins →</a>
      <a href="/cabin-1/">Cabin Quetzal →</a>
      <a href="/cabin-2/">Cabin Hummingbird →</a>
    </div>
  </Fragment>
</PageLayout>
