---
import { getImage } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { business } from '../data/business';
import { img } from '../lib/images';
import { mailtoHref } from '../i18n/utils';

const heroImage = img('farm/property_overview.jpg');
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'webp' });
---

<PageLayout
  title="Contact — Wild on the Farm | Boquete Cloud Forest Lodge"
  description="How to reach Wild on the Farm, Boquete Cloud Forest Lodge, directly by WhatsApp or email."
  path="/contact/"
  image={ogImage.src}
  pullIntro="Have a question that's not covered in the FAQs? Just write to us directly."
>
  <Fragment slot="hero">
    <PageHero image={heroImage} alt="Aerial view of the farm property" eyebrow="Get In Touch">
      How to reach us.
    </PageHero>
  </Fragment>

  <Section label="Get In Touch" heading="We answer WhatsApp faster than email.">
    <div class="contact-list contact-list-lg">
      <a href={business.whatsappHref}>{business.phone} (WhatsApp)</a>
      <a href={mailtoHref(business.email, 'en')}>{business.email}</a>
    </div>
  </Section>

  <Section label="Find Us" heading="Where to find us in Boquete.">
    <div class="map-embed">
      <iframe
        title="Wild on the Farm location on Google Maps"
        width="100%"
        height="450"
        style="border:0"
        loading="lazy"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3942.6012169702753!2d-82.45058332498353!3d8.823481391229862!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa5edd18b24f369%3A0x11b58604931f7e19!2sWild%20on%20the%20farm!5e0!3m2!1sfr!2spa!4v1787767091890!5m2!1sfr!2spa"
      />
    </div>
    <div class="contact-list">
      <a href="https://www.google.com/maps?cid=1276073423635709465">See our reviews on Google →</a>
    </div>
  </Section>

  <Fragment slot="footer">
    <div class="section-label">Before You Ask</div>
    <h2>Check the FAQs — your question might already be answered.</h2>
    <div class="contact-list">
      <a href="/faq/">FAQs →</a>
      <a href="/rates-retreats/">Rates &amp; Retreats →</a>
      <a href="/lodge/">See The Cabins →</a>
    </div>
  </Fragment>
</PageLayout>
